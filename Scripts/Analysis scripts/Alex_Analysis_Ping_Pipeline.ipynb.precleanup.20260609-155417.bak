   "source": [
    "# Test disease-associated substitution trends within tissues using per-SAAP Spearman correlations.\n",
    "# For each aa_sub within each tissue:\n",
    "#   1. one disease-trajectory rho per unique SAAP (RAAS vs ordinal disease code)\n",
    "#   2. test whether the distribution of SAAP-level rhos differs from zero (Wilcoxon + 1-sample t)\n",
    "required_diseases = len(disease_order)\n",
    "\n",
    "sub_df = add_replicate_cols(SAAP_quant_df_grouped)\n",
    "sub_df['Disease_num'] = sub_df['Disease'].map(disease_map)\n",
    "sub_df = sub_df.replace([np.inf, -np.inf], np.nan).dropna(subset=[raas_col, 'Disease_num'])\n",
    "\n",
    "# median RAAS for each unique SAAP within tissue+disease\n",
    "saap_keys = ['Tissue', 'Disease', 'Disease_num'] + SAAP_KEYS\n",
    "saap_df = (sub_df.groupby(saap_keys, observed=False)[raas_col]\n",
    "           .median().reset_index(name='SAAP_median_RAAS'))\n",
    "saap_df['SAAP_ID'] = saap_df[['Tissue'] + SAAP_KEYS].astype(str).agg('|'.join, axis=1)\n",
    "\n",
    "results = []\n",
    "for tissue in sorted(saap_df['Tissue'].dropna().unique()):\n",
    "    tissue_df = saap_df[saap_df['Tissue'] == tissue].copy()\n",
    "    for sub in sorted(tissue_df['aa_sub'].dropna().unique()):\n",
    "        curr = tissue_df[tissue_df['aa_sub'] == sub].copy()\n",
    "        saap_rhos = []\n",
    "        for saap_id, saap_curr in curr.groupby('SAAP_ID', observed=False):\n",
    "            saap_curr = saap_curr.sort_values('Disease_num')\n",
    "            # require all disease groups present (one value per disease)\n",
    "            if saap_curr['Disease_num'].nunique() != required_diseases:\n",
    "                continue\n",
    "            rho, p = spearmanr(saap_curr['Disease_num'], saap_curr['SAAP_median_RAAS'])\n",
    "            if np.isnan(rho) or np.isinf(rho):\n",
    "                continue\n",
    "            saap_rhos.append(rho)\n",
    "\n",
    "        saap_rhos = np.array(saap_rhos, dtype=float)\n",
    "        n_saap = len(saap_rhos)\n",
    "        if n_saap < min_saap:\n",
    "            continue\n",
    "\n",
    "        mean_rho = np.mean(saap_rhos)\n",
    "        median_rho = np.median(saap_rhos)\n",
    "\n",
    "        # nonparametric test against zero\n",
    "        try:\n",
    "            w_stat, w_p = wilcoxon(saap_rhos, zero_method='wilcox', alternative='two-sided')\n",
    "        except ValueError:\n",
    "            w_stat, w_p = np.nan, np.nan\n",
    "\n",
    "        # parametric test against zero\n",
    "        try:\n",
    "            t_stat, t_p = ttest_1samp(saap_rhos, popmean=0, nan_policy='omit')\n",
    "        except ValueError:\n",
    "            t_stat, t_p = np.nan, np.nan\n",
    "\n",
    "        direction = ('Increasing' if median_rho > 0 else\n",
    "                     'Decreasing' if median_rho < 0 else 'None')\n",
    "\n",
    "        results.append([tissue, sub, n_saap, mean_rho, median_rho,\n",
    "                        w_stat, w_p, t_stat, t_p, direction, list(saap_rhos)])\n",
    "\n",
    "results = pd.DataFrame(results, columns=[\n",
    "    'Tissue', 'aa_sub', 'n_saap', 'mean_rho', 'median_rho',\n",
    "    'wilcoxon_stat', 'wilcoxon_p', 'ttest_stat', 'ttest_p', 'direction', 'SAAP_rhos'])\n",
    "\n",
    "# BH-FDR correction on Wilcoxon p-values\n",
    "results = run_fdr(results, p_col='wilcoxon_p')\n",
    "results['Significance'] = results['FDR'].apply(add_sig_label)\n",
    "results = results.sort_values(['FDR', 'wilcoxon_p', 'n_saap'], ascending=[True, True, False])\n",
    "\n",
    "print('Total tests:', len(results))\n",
    "print('Nominal Wilcoxon p<0.05:', (results['wilcoxon_p'] < 0.05).sum())\n",
    "print('BH-FDR<0.01:', (results['FDR'] < 0.01).sum())\n",
    "print(results[['Tissue', 'aa_sub', 'n_saap', 'mean_rho', 'median_rho',\n",
    "               'wilcoxon_p', 'ttest_p', 'FDR', 'Significance', 'direction']])\n",
    "\n",
    "results.to_csv(\n",
    "    OUTDIR + 'Spearman_RAASDifference_wDisease_SAAPrhoDistribution_withinTissue_table.tsv',\n",
    "    sep='\\t', index=False)\n"
   ]
  },
