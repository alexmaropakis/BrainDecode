     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# 4e. Pooled-disease per-SAAP RAAS volcano — Brain cohort (individual-SAAP level, max power).\n",
    "# Per SAAP: Welch t-test of log10 RAAS (AD+PD+ADPD pooled) vs CTRL, BH-FDR across SAAPs.\n",
    "# ALL testable SAAPs are plotted; those passing the SAME rule as the 4a heatmap\n",
    "# (p <= sel_thresh & |log2FC| >= min_abs_log2fc) are colored by substitution (swap) type\n",
    "# (colors match the other section-4 figures via the cohort palette).\n",
    "def plot_pooled_saap_volcano(cohort, label_top=10):\n",
    "    cohort_df, name = cohort['df'], cohort['name']\n",
    "    swap_colors = swap_palette(cohort_df['aa_sub'].unique())           # complete & consistent palette\n",
    "    rows = []\n",
    "    for keys, grp in cohort_df.groupby(SAAP_KEYS, observed=True):\n",
    "        ctrl_v = grp.loc[grp['Disease'] == ctrl_label, 'log10_RAAS'].dropna().values\n",
    "        dis_v = grp.loc[grp['Disease'] != ctrl_label, 'log10_RAAS'].dropna().values\n",
    "        if len(ctrl_v) < min_reps or len(dis_v) < min_reps:\n",
    "            continue\n",
    "        _, p = ttest_ind(dis_v, ctrl_v, equal_var=False)\n",
    "        rows.append({'MTP_seq': keys[0], 'BP_seq': keys[1], 'aa_sub': keys[2],\n",
    "                     'mean_log2FC': (np.mean(dis_v) - np.mean(ctrl_v)) * np.log2(10), 'p_value': p})\n",
    "    d = pd.DataFrame(rows)\n",
    "    if d.empty:\n",
    "        print(f'[{name}] no testable SAAPs.'); return\n",
    "    d = run_fdr(d, p_col='p_value', out_col='FDR')\n",
    "    d['SAAP'] = d['aa_sub'] + ' | ' + d['MTP_seq']\n",
    "    d.to_csv(f'{PLOT_DIR}SAAP_pooled_disease_ttest_{name}.tsv', sep='\\t', index=False)\n",
    "    d['y'] = -np.log10(d[sel_metric].clip(lower=1e-300))\n",
    "    sig = (d[sel_metric] <= sel_thresh) & (d['mean_log2FC'].abs() >= min_abs_log2fc)\n",
    "    ds = d[sig]\n",
    "    fig, ax = plt.subplots(figsize=(4.8, 4))\n",
    "    ax.scatter(d.loc[~sig, 'mean_log2FC'], d.loc[~sig, 'y'], s=POINT_SIZE, color=COLOR_NS,\n",
    "               alpha=ALPHA, edgecolor=EDGE_COLOR)\n",
    "    ax.scatter(ds['mean_log2FC'], ds['y'], s=POINT_SIZE,\n",
    "               color=[swap_colors.get(a, COLOR_NS) for a in ds['aa_sub']], alpha=ALPHA, edgecolor=EDGE_COLOR)\n",
    "    ax.axvline(min_abs_log2fc, color='gray', ls='--', lw=0.7); ax.axvline(-min_abs_log2fc, color='gray', ls='--', lw=0.7)\n",
    "    ax.axhline(-np.log10(sel_thresh), color='gray', ls='--', lw=0.7)\n",
    "    for _, r in ds.sort_values('y', ascending=False).head(label_top).iterrows():\n",
    "        ax.annotate(r['aa_sub'].replace(' to ', '→'), xy=(r['mean_log2FC'], r['y']),\n",
    "                    xytext=(5, 2), textcoords='offset points', fontsize=6,\n",
    "                    arrowprops=dict(arrowstyle='-', lw=0.3, color='gray'))\n",
    "    ax.set_xlabel(r'log$_2$[RAAS$_{disease}$/RAAS$_{CTRL}$]', fontsize=LABEL_SIZE)\n",
    "    ax.set_ylabel(r'$-\\log_{10}$(%s)' % sig_metric_label, fontsize=LABEL_SIZE)\n",
    "    ax.set_title(f'{name}: all disease (pooled) vs CTRL — per SAAP', fontsize=TITLE_SIZE)\n",
    "    present = sorted(ds['aa_sub'].unique())\n",
    "    handles = [Line2D([0], [0], marker='o', ls='', markersize=6, markeredgecolor='none',\n",
    "                      markerfacecolor=swap_colors[a], label=a.replace(' to ', '→')) for a in present]\n",
    "    if handles:\n",
    "        ax.legend(handles=handles, title='substitution', fontsize=LEGEND_SIZE, title_fontsize=LEGEND_SIZE,\n",
    "                  frameon=False, loc='center left', bbox_to_anchor=(1.02, 0.5),\n",
    "                  ncol=1 if len(handles) <= 18 else 2)\n",
    "    ax.spines['left'].set_visible(True); ax.spines['bottom'].set_visible(True)\n",
    "    ax.tick_params(left=True, bottom=True, length=3, labelsize=TICK_SIZE)\n",
    "    plt.tight_layout()\n",
    "    fig.savefig(f'{PLOT_DIR}SAAP_pooled_disease_volcano_{name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_pooled_saap_volcano(COHORTS['Brain'])\n"
   ]
  },
