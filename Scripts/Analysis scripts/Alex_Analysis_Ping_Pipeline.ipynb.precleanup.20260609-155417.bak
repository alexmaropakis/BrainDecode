   "source": [
    "# Plot the 15 most frequent substitution types by UNIQUE SAAP count (ACG)\n",
    "sub_df = SAAP_quant_df_acg.copy().drop_duplicates(subset=['Dataset'] + SAAP_KEYS)   # unique SAAPs per batch\n",
    "top_subs = top_substitutions(sub_df, n=15)\n",
    "plot_df = sub_df[sub_df['aa_sub'].isin(top_subs)]\n",
    "sub_order = plot_df['aa_sub'].value_counts().index\n",
    "fig, ax = plt.subplots(figsize=(4, 5))\n",
    "sns.countplot(data=plot_df, y='aa_sub', order=sub_order, color=ACG_color, ax=ax)\n",
    "ax.tick_params('both', labelsize=12)\n",
    "plt.xlabel('# Unique SAAPs', fontsize=14)\n",
    "plt.ylabel('AA Substitution', fontsize=14)\n",
    "plt.title('Top 15 substitutions by frequency — ACG\\n(unique SAAPs per batch)', fontsize=13)\n",
    "plt.tick_params(axis='both', length=5)\n",
    "despine()\n",
    "plt.savefig(PLOT_DIR + 'top15_SAAP_substitutions_acg.pdf', bbox_inches='tight')\n",
    "\n",
    "\n",
    "# Plot the 15 most frequent substitution types by UNIQUE SAAP count (FC)\n",
    "sub_df = SAAP_quant_df_fc.copy().drop_duplicates(subset=['Dataset'] + SAAP_KEYS)   # unique SAAPs per batch\n",
    "top_subs = top_substitutions(sub_df, n=15)\n",
    "plot_df = sub_df[sub_df['aa_sub'].isin(top_subs)]\n",
    "sub_order = plot_df['aa_sub'].value_counts().index\n",
    "fig, ax = plt.subplots(figsize=(4, 5))\n",
    "sns.countplot(data=plot_df, y='aa_sub', order=sub_order, color=FC_color, ax=ax)\n",
    "ax.tick_params('both', labelsize=12)\n",
    "plt.xlabel('# Unique SAAPs', fontsize=14)\n",
    "plt.ylabel('AA Substitution', fontsize=14)\n",
    "plt.title('Top 15 substitutions by frequency — FC\\n(unique SAAPs per batch)', fontsize=13)\n",
    "plt.tick_params(axis='both', length=5)\n",
    "despine()\n",
    "plt.savefig(PLOT_DIR + 'top15_SAAP_substitutions_fc.pdf', bbox_inches='tight')\n"
   ]
  },
