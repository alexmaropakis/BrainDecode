   "source": [
    "## Plotting style — single source of truth for figure aesthetics\n",
    "# Flip this ONE line to switch every plot between a clean despined look and a full box:\n",
    "SHOW_BOX = False   # False = top/right spines removed (despined);  True = full box on all sides\n",
    "\n",
    "\n",
    "def apply_plot_style():\n",
    "    \"\"\"Uniform matplotlib/seaborn defaults for every figure in the notebook.\n",
    "    Spine visibility is driven by the SHOW_BOX toggle above.\"\"\"\n",
    "    sns.set_style('ticks')\n",
    "    plt.rcParams.update({\n",
    "        # fonts\n",
    "        'font.family': 'sans-serif', 'font.size': 12,\n",
    "        'axes.titlesize': 14, 'axes.labelsize': 14,\n",
    "        'xtick.labelsize': 12, 'ytick.labelsize': 12,\n",
    "        'legend.fontsize': 11, 'legend.frameon': False,\n",
    "        # ticks\n",
    "        'xtick.direction': 'out', 'ytick.direction': 'out',\n",
    "        'xtick.major.size': 5, 'ytick.major.size': 5,\n",
    "        'xtick.bottom': True, 'ytick.left': True, 'xtick.top': False, 'ytick.right': False,\n",
    "        # spines (driven by the SHOW_BOX toggle)\n",
    "        'axes.spines.top': SHOW_BOX, 'axes.spines.right': SHOW_BOX,\n",
    "        'axes.spines.left': True, 'axes.spines.bottom': True,\n",
    "        # background / grid / saving\n",
    "        'axes.grid': False, 'axes.linewidth': 1.0,\n",
    "        'figure.facecolor': 'white', 'axes.facecolor': 'white', 'savefig.facecolor': 'white',\n",
    "        'savefig.bbox': 'tight', 'savefig.dpi': 300, 'figure.dpi': 110,\n",
    "    })\n",
    "\n",
    "\n",
    "apply_plot_style()\n",
    "\n",
    "\n",
    "def despine(ax=None, fig=None, **kwargs):\n",
    "    \"\"\"Frame helper honoring SHOW_BOX; use in place of sns.despine().\n",
    "      - SHOW_BOX False -> remove the top/right spines (clean look)\n",
    "      - SHOW_BOX True  -> ensure all four spines are visible (full box)\n",
    "    \"\"\"\n",
    "    if SHOW_BOX:\n",
    "        axes = [ax] if ax is not None else (fig.axes if fig is not None else plt.gcf().axes)\n",
    "        for a in axes:\n",
    "            for sp in a.spines.values():\n",
    "                sp.set_visible(True)\n",
    "    else:\n",
    "        sns.despine(ax=ax, fig=fig, **kwargs)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5b010615",
   "metadata": {},
   "source": [
    "## Data Processing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 116,
   "id": "9c05bb3d",
   "metadata": {},
   "outputs": [],
   "source": [
    "## build_peptide_filter_df\n",
    "def build_peptide_filter_df(data_dir, samples):\n",
    "    \"\"\"Peptide counts at each decode-pipeline filtering step, one row per TMT set.\n",
    "    Input: a dataset's output directory and its sample/TMT-set names.\n",
    "    Output: DataFrame of peptide counts surviving each category (main -> validated).\"\"\"\n",
    "    dp_ev_dict   = pickle.load(open(data_dir + 'DP_search_evidence_dict.p', 'rb'))\n",
    "    dp_dict      = pickle.load(open(data_dir + 'DP_dict.p', 'rb'))\n",
    "    mtp_dict     = pickle.load(open(data_dir + 'MTP_dict.p', 'rb'))\n",
    "    ptm_dict     = pickle.load(open(data_dir + 'PTM_dict.p', 'rb'))\n",
    "    hc_mtp_dict  = pickle.load(open(data_dir + 'qMTP_dict.p', 'rb'))            # substitutions passing FDR\n",
    "    substr_dict  = pickle.load(open(data_dir + 'genome_substr_dict.p', 'rb'))\n",
    "    val_mtp_dict = pickle.load(open(data_dir + 'Ion_validated_MTP_dict.p', 'rb'))\n",
    "\n",
    "    # the homolog reference set is identical for every sample -> build it once\n",
    "    homolog_seqs = substr_dict.get('all_6frame_seqs', substr_dict.get('all_frame6_seqs'))\n",
    "    all_seqs = [x for s in samples for v in mtp_dict[s]['mistranslated sequence'].values() for x in v]\n",
    "    seqs_hom = [x for x in all_seqs if x in homolog_seqs]\n",
    "\n",
    "    rows = []\n",
    "    for s in samples:\n",
    "        n_main  = len(dp_ev_dict[s]['Raw file'])\n",
    "        n_dp    = len(dp_dict[s]['Raw file'])\n",
    "        n_ptm   = len(ptm_dict[s]['Raw file'])\n",
    "        n_aas   = len(mtp_dict[s]['Raw file'])\n",
    "        n_nohom = len([i for i, x in mtp_dict[s]['mistranslated sequence'].items() if all(y not in seqs_hom for y in x)])\n",
    "        n_hc    = len([i for i, x in hc_mtp_dict[s]['mistranslated sequence'].items() if all(y not in seqs_hom for y in x)])\n",
    "        n_val   = len(val_mtp_dict[s]['Raw file'])\n",
    "        rows.append([s, n_main, n_dp, n_ptm, n_aas, n_nohom, n_hc, n_val])\n",
    "    return pd.DataFrame(rows, columns=['TMT set', 'Main peptides', 'DP', 'PTM', 'AAS',\n",
    "                                       'Non-homologous', 'High-confidence', 'Validated'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 117,
   "id": "d59a04c6",
   "metadata": {},
   "outputs": [],
   "source": [
    "## build_ptm_count_matrix\n",
    "def build_ptm_count_matrix(ptm_dict):\n",
    "    \"\"\"PTM x sample count matrix (rows = PTMs, columns = sample index 1..23) from PTM_dict.p.\"\"\"\n",
    "    master_ptm_list = []\n",
    "    for v in ptm_dict.values():\n",
    "        for ptm_list in v['PTM'].values():\n",
    "            new_ptm_list = list(set(x for x in ptm_list if x not in master_ptm_list))\n",
    "            master_ptm_list = master_ptm_list + new_ptm_list\n",
    "\n",
    "    heatmap_df = pd.DataFrame(index=master_ptm_list, columns=list(range(1, 24)))\n",
    "    for s, v in ptm_dict.items():\n",
    "        s_int = int(s[1:]) if isinstance(s, str) and s.startswith('S') else s\n",
    "        ptm_count = Counter(x for ptm_list in v['PTM'].values() for x in ptm_list)\n",
    "        for ptm, count in ptm_count.items():\n",
    "            heatmap_df.loc[ptm, s_int] = count\n",
    "    heatmap_df.fillna(0, inplace=True)\n",
    "    return heatmap_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 118,
   "id": "e2e2b5f0",
   "metadata": {},
   "outputs": [],
   "source": [
    "## count_candidate_saaps\n",
    "def count_candidate_saaps(data_dir, s):\n",
    "    \"\"\"Number of unique candidate (FDR-passing) substituted peptides for a sample.\"\"\"\n",
    "    hc_mtp_dict = pickle.load(open(data_dir + 'qMTP_dict.p', 'rb'))\n",
    "    return len({x for y in hc_mtp_dict[s]['mistranslated sequence'].values() for x in y})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 119,
   "id": "7eca4ebe",
   "metadata": {},
   "outputs": [],
   "source": [
    "## count_validated_saaps\n",
    "def count_validated_saaps(data_dir, s):\n",
    "    \"\"\"Number of unique validated substituted peptides for a sample.\n",
    "    NOTE: unlike count_candidate_saaps this does NOT flatten the per-key sequence\n",
    "    lists before de-duplicating; kept as-is pending review of the dict structure.\"\"\"\n",
    "    val_mtp_dict = pickle.load(open(data_dir + 'Ion_validated_MTP_dict.p', 'rb'))\n",
    "    return len(set(val_mtp_dict[s]['mistranslated sequence'].values()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 120,
   "id": "5809b443",
   "metadata": {},
   "outputs": [],
   "source": [
    "## add_replicate_cols\n",
    "def add_replicate_cols(df):\n",
    "    \"\"\"Add Disease / Tissue / Patient columns derived from the raw sample metadata.\"\"\"\n",
    "    saap_df = df.copy()\n",
    "    saap_df['Disease'] = saap_df['Sample Type']\n",
    "    saap_df['Tissue'] = saap_df['Dataset']\n",
    "    saap_df['Patient'] = saap_df['Sample'].str.split('_').str[0]\n",
    "    return saap_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 121,
   "id": "deebb7ab",
   "metadata": {},
   "outputs": [],
   "source": [
    "## top_substitutions\n",
    "def top_substitutions(df, n=15):\n",
    "    \"\"\"The n most frequent substitution types (aa_sub), for a standardized plot order.\"\"\"\n",
    "    return df['aa_sub'].value_counts().head(n).index"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 122,
   "id": "a17271e8",
   "metadata": {},
   "outputs": [],
   "source": [
    "## saap_level_median\n",
    "def saap_level_median(df, group_cols, value_col=raas_col):\n",
    "    # collapse repeated observations for the same SAAP within each requested group\n",
    "    return (df.groupby(list(group_cols)+['MTP_seq','BP_seq','aa_sub'], observed=True)[value_col].median().reset_index())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 123,
   "id": "b4427c6a",
   "metadata": {},
   "outputs": [],
   "source": [
    "## core_saaps_by_tmt\n",
    "# SAAPs present in at least 3 of the given TMT sets for a tissue\n",
    "def core_saaps_by_tmt(df, tmt_list):\n",
    "    sub = (df[df['Dataset'].isin(tmt_list)][['Dataset', 'MTP_seq']].drop_duplicates())\n",
    "    mat = (sub.assign(present=1).pivot_table(index='MTP_seq',columns='Dataset',values='present',fill_value=0))\n",
    "    # ensure all expected TMT columns exist\n",
    "    mat = mat.reindex(columns=tmt_list, fill_value=0)\n",
    "    # SAAP must appear in ALL TMT sets\n",
    "    # core = mat.index[mat.sum(axis=1) == len(tmt_list)]\n",
    "    core = mat.index[mat.sum(axis=1) >= 3]\n",
    "    return set(core)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 124,
   "id": "33b622d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "## core_saaps_by_disease\n",
    "# SAAPs present in every disease state\n",
    "def core_saaps_by_disease(df, disease_order):\n",
    "    sub = (df[df['Sample Type'].isin(disease_order)][['Sample Type', 'MTP_seq']].drop_duplicates())\n",
    "    mat = (sub.assign(present=1).pivot_table(index='MTP_seq',columns='Sample Type',values='present',fill_value=0))\n",
    "    # ensure all expected disease state columns exist\n",
    "    mat = mat.reindex(columns=disease_order, fill_value=0)\n",
    "    # SAAP must appear in ALL disease states\n",
    "    core = mat.index[mat.sum(axis=1) == len(disease_order)]\n",
    "    return set(core)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 125,
   "id": "filtercompletesaaps01",
   "metadata": {},
   "outputs": [],
   "source": [
    "## filter_complete_saaps\n",
    "# Keep only SAAPs detected in EVERY disease state, optionally within each `within`\n",
    "# group (e.g. per Tissue). No-op unless COMPLETE_SAAPS_ONLY. Applied per cohort so\n",
    "# each comparison uses SAAPs observed across all of its disease states.\n",
    "def filter_complete_saaps(df, *, disease_col='Disease', saap_keys=SAAP_KEYS,\n",
    "                          within=None, complete_only=None):\n",
    "    complete_only = COMPLETE_SAAPS_ONLY if complete_only is None else complete_only\n",
    "    if not complete_only or disease_col not in df.columns:\n",
    "        return df\n",
    "    grp = (within or []) + list(saap_keys)\n",
    "    states = [d for d in disease_order if d in df[disease_col].unique()]\n",
    "    present = (df[grp + [disease_col]].drop_duplicates()\n",
    "               .groupby(grp, observed=True)[disease_col].nunique())\n",
    "    keep = present[present == len(states)].reset_index()[grp]\n",
    "    return df.merge(keep, on=grp, how='inner')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 126,
   "id": "c70866ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "## classify_substitution\n",
    "def classify_substitution(sub):\n",
    "    \"\"\"Conservative vs Nonconservative by AA biochemical group.\n",
    "    I and L are isobaric (MS-indistinguishable, labeled 'I/L'); both nonpolar, so unambiguous.\"\"\"\n",
    "    aa1, aa2 = sub.split(\" to \")\n",
    "    grp = lambda aa: aa_groups[\"I\"] if aa == \"I/L\" else aa_groups[aa]\n",
    "    return \"Conservative\" if grp(aa1) == grp(aa2) else \"Nonconservative\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 127,
   "id": "7c2887bf",
   "metadata": {},
   "outputs": [],
   "source": [
    "## saap_mass_error\n",
    "def saap_mass_error(saap, s_saap_dict):\n",
    "    \"\"\"Median aa-substitution mass error (ppm) for a SAAP; NaN if the SAAP is absent.\"\"\"\n",
    "    saap_idx = [k for k, v in s_saap_dict['mistranslated sequence'].items() if v == saap]\n",
    "    if not saap_idx:\n",
    "        print(f\"WARNING: SAAP {saap} not found in mistranslated sequence\")\n",
    "        return np.nan\n",
    "    return np.median([s_saap_dict['aa subs mass error (ppm)'][k] for k in saap_idx])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 128,
   "id": "358815c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "## datasets_for_saap\n",
    "def datasets_for_saap(saap, bp, SAAP_quant_df):\n",
    "    \"\"\"List of datasets a given SAAP-BP pair is found in.\"\"\"\n",
    "    pair = SAAP_quant_df.loc[(SAAP_quant_df['MTP_seq'] == saap) & (SAAP_quant_df['BP_seq'] == bp)]\n",
    "    return pair['Dataset'].tolist()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4c8b9ece",
   "metadata": {},
   "source": [
    "## Figure Formatting & Plotting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 129,
   "id": "c5c3a451",
   "metadata": {},
   "outputs": [],
   "source": [
    "## bihist\n",
    "def bihist(y1, y2, nbins=10, h=None, color='#aaaaaa'):\n",
    "    '''\n",
    "    Function used to create violin plots as bihistograms with no smoothing.\n",
    "    h is an axis handle. If not present, a new figure is created.\n",
    "    '''\n",
    "    if h is None: h = plt.figure().add_subplot(111)\n",
    "    ymin = np.floor(np.minimum(min(y1), min(y2)))\n",
    "    ymax = np.ceil(np.maximum(max(y1), max(y2)))\n",
    "    bins = np.linspace(ymin, ymax, nbins)\n",
    "    n1, bins1, patch1 = h.hist(y1, bins, orientation='horizontal', color=color, edgecolor=None, linewidth=0,rwidth=1)\n",
    "    n2, bins2, patch2 = h.hist(y2, bins, orientation='horizontal', color=color, edgecolor=None, linewidth=0,rwidth=1)\n",
    "    # set xmax:\n",
    "    xmax = 0\n",
    "    for i in patch1:\n",
    "        i.set_edgecolor(None)\n",
    "        width = i.get_width()\n",
    "        if width > xmax: xmax = width\n",
    "    # invert second histogram and set xmin:\n",
    "    xmin = 0\n",
    "    for i in patch2:\n",
    "        i.set_edgecolor(None)\n",
    "        width = i.get_width()\n",
    "        width = -width\n",
    "        i.set_width(width)\n",
    "        if width < xmin: xmin = width\n",
    "    h.set_xlim(xmin*1.1, xmax*1.1)\n",
    "    h.figure.canvas.draw()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 130,
   "id": "f70adbeb",
   "metadata": {},
   "outputs": [],
   "source": [
    "## style_cbar / heatmap_cbar — canonical colorbar look\n",
    "# Every colorbar: slim vertical, no outline, no minor ticks, short outward ticks,\n",
    "# ALWAYS a vertical right-side label, and ALWAYS ticks at the start / middle / end\n",
    "# of the spectrum (middle = 0 for diverging maps). Accepts a Colorbar or a colorbar\n",
    "# Axes (e.g. a seaborn clustermap's .ax_cbar; tick-setting is skipped for a bare Axes).\n",
    "def style_cbar(cb, label, *, labelsize=15, ticksize=13, labelpad=6):\n",
    "    ax = getattr(cb, 'ax', cb)\n",
    "    ax.set_ylabel(label, rotation=90, labelpad=labelpad, fontsize=labelsize)\n",
    "    # mark beginning / middle / end of the spectrum\n",
    "    mappable = getattr(cb, 'mappable', None)\n",
    "    if mappable is not None and hasattr(cb, 'set_ticks'):\n",
    "        vmin, vmax = mappable.get_clim()\n",
    "        vmid = 0.0 if vmin < 0 < vmax else (vmin + vmax) / 2   # 0 for diverging maps\n",
    "        cb.set_ticks([vmin, vmid, vmax])\n",
    "        cb.set_ticklabels([fmt_cbar(vmin), fmt_cbar(vmid), fmt_cbar(vmax)])\n",
    "    ax.tick_params(length=3, labelsize=ticksize, direction='out')\n",
    "    ax.minorticks_off()\n",
    "    outline = getattr(cb, 'outline', None)\n",
    "    if outline is not None:\n",
    "        outline.set_visible(False)\n",
    "    else:\n",
    "        for sp in ax.spines.values():\n",
    "            sp.set_visible(False)\n",
    "    return cb\n",
    "\n",
    "\n",
    "## strip_box / heatmap_cbar / CBAR_POS — canonical heatmap + colorbar formatting\n",
    "# Heatmaps are NEVER boxed (independent of SHOW_BOX); every colorbar uses the\n",
    "# same slim vertical look as the correlation clustermap.\n",
    "CBAR_POS = [0.9, 0.26, 0.05, 0.5]   # clustermap .ax_cbar geometry (figure fraction)\n",
    "\n",
    "\n",
    "def strip_box(ax=None):\n",
    "    \"\"\"Remove all spines — heatmaps have no box regardless of SHOW_BOX.\"\"\"\n",
    "    ax = ax if ax is not None else plt.gca()\n",
    "    for sp in ax.spines.values():\n",
    "        sp.set_visible(False)\n",
    "    return ax\n",
    "\n",
    "\n",
    "def heatmap_cbar(label, mappable=None, ax=None):\n",
    "    \"\"\"Canonical slim vertical colorbar for imshow heatmaps (start/middle/end ticks\n",
    "    and a required label, styled via style_cbar).\"\"\"\n",
    "    parent = ax if ax is not None else plt.gca()\n",
    "    kw = dict(fraction=0.046, pad=0.02, shrink=0.5, aspect=15)\n",
    "    cbar = plt.colorbar(mappable, ax=ax, **kw) if mappable is not None else plt.colorbar(**kw)\n",
    "    style_cbar(cbar, label)\n",
    "    plt.sca(parent)   # keep the heatmap axes current for subsequent plt.* / strip_box\n",
    "    return cbar\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 131,
   "id": "2f2acb81",
   "metadata": {},
   "outputs": [],
   "source": [
    "## plot_cohort_heatmap\n",
    "# Substitution x disease heatmap of median-RAAS log2FC vs the tissue-specific CTRL baseline.\n",
    "def plot_cohort_heatmap(cohort_df, cohort_name):\n",
    "    cohort_df = filter_complete_saaps(cohort_df)                       # complete SAAPs per cohort\n",
    "    tissue_order = ([t for t in TISSUE_ORDER if t in cohort_df['Tissue'].unique()]\n",
    "                    or sorted(cohort_df['Tissue'].dropna().unique()))\n",
    "\n",
    "    plot_df = cohort_df.copy()\n",
    "    plot_df['Tissue'] = pd.Categorical(plot_df['Tissue'], categories=tissue_order, ordered=True)\n",
    "    plot_df['Disease'] = pd.Categorical(plot_df['Disease'], categories=disease_order, ordered=True)\n",
    "\n",
    "    # median RAAS per unique SAAP within tissue+disease; keep AAS with enough qualifying SAAPs\n",
    "    saap_keys = ['Tissue', 'Disease'] + SAAP_KEYS\n",
    "    saap_median_df = (plot_df.groupby(saap_keys, observed=False)['log10_RAAS']\n",
    "                      .median().reset_index(name='SAAP_median_log10_RAAS'))\n",
    "    aas_counts = (saap_median_df.groupby(['Tissue', 'Disease', 'aa_sub'], observed=False)\n",
    "                  .size().reset_index(name='n_saap'))\n",
    "    valid_aas = aas_counts[aas_counts['n_saap'] >= min_saap_per_aas][['Tissue', 'Disease', 'aa_sub']]\n",
    "    saap_median_df = saap_median_df.merge(valid_aas, on=['Tissue', 'Disease', 'aa_sub'], how='inner')\n",
    "    aas_median_df = (saap_median_df.groupby(['Tissue', 'Disease', 'aa_sub'], observed=False)['SAAP_median_log10_RAAS']\n",
    "                     .median().reset_index(name='AAS_median_log10_RAAS'))\n",
    "\n",
    "    # tissue-specific log2 fold change vs CTRL\n",
    "    ctrl_df = (aas_median_df[aas_median_df['Disease'] == ctrl_label]\n",
    "               [['Tissue', 'aa_sub', 'AAS_median_log10_RAAS']]\n",
    "               .rename(columns={'AAS_median_log10_RAAS': 'CTRL_AAS_median_log10_RAAS'}))\n",
    "    norm_df = aas_median_df.merge(ctrl_df, on=['Tissue', 'aa_sub'], how='left')\n",
    "    norm_df['log2FC_vs_CTRL'] = (norm_df['AAS_median_log10_RAAS'] - norm_df['CTRL_AAS_median_log10_RAAS']) * np.log2(10)\n",
    "    norm_df = norm_df.dropna(subset=['log2FC_vs_CTRL']).copy()\n",
    "\n",
    "    # substitutions ordered by mean fold change (high -> low); columns ACG-then-FC\n",
    "    sub_order = norm_df.groupby('aa_sub')['log2FC_vs_CTRL'].mean().sort_values(ascending=False).index.tolist()\n",
    "    norm_df['Tissue_Disease'] = norm_df['Tissue'].astype(str) + '_' + norm_df['Disease'].astype(str)\n",
    "    column_order = order_tissue_disease([f'{t}_{d}' for t in tissue_order for d in disease_order])\n",
    "    heatmap_matrix = (norm_df.pivot(index='aa_sub', columns='Tissue_Disease', values='log2FC_vs_CTRL')\n",
    "                      .reindex(index=sub_order).reindex(columns=column_order))\n",
    "    max_abs = np.nanmax(np.abs(norm_df['log2FC_vs_CTRL'].values))\n",
    "\n",
    "    plt.figure(figsize=(15, 30))\n",
    "    plt.imshow(heatmap_matrix, aspect='auto', cmap=cmap, vmin=-max_abs, vmax=max_abs)\n",
    "    heatmap_cbar(r'log$_2$(median RAAS / tissue CTRL)')\n",
    "    for x in np.arange(len(disease_order), len(column_order), len(disease_order)) - 0.5:\n",
    "        plt.axvline(x, color='white', linewidth=2)                    # separate tissue blocks\n",
    "    ax = plt.gca()\n",
    "    for ti, t in enumerate(tissue_order):                             # tissue label above each block\n",
    "        ax.annotate(t.upper(), xy=((ti * len(disease_order) + len(disease_order) / 2) / len(column_order), 1.01),\n",
    "                    xycoords='axes fraction', ha='center', va='bottom', fontsize=26, fontweight='bold')\n",
    "    plt.xticks(np.arange(len(column_order)), [pretty_disease(c) for c in column_order], rotation=90, fontsize=25)\n",
    "    plt.yticks(np.arange(len(heatmap_matrix.index)), heatmap_matrix.index, fontsize=25)\n",
    "    plt.xlabel('Disease', fontsize=30); plt.ylabel('AA substitution', fontsize=30)\n",
    "    plt.title(f'{cohort_name}: substitution RAAS log$_2$ fold change vs tissue-specific CTRL\\n'\n",
    "              f'(per-SAAP median RAAS; AAS with ≥{min_saap_per_aas} qualifying SAAPs; columns ACG→FC × CTRL/AD/PD/ADPD)',\n",
    "              fontsize=22, pad=40)\n",
    "    plt.tight_layout(); plt.tick_params(axis='both', length=5); plt.grid(False); strip_box()\n",
    "    plt.savefig(f'{PLOT_DIR}top_substitution_log2FC_tissue_specific_CTRL_heatmap_{cohort_name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n"
   ]
