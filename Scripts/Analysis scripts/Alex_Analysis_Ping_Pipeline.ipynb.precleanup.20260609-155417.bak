   "outputs": [],
   "source": [
    "## prep_cohort\n",
    "# Add replicate columns and a log10_RAAS column; drop non-finite RAAS\n",
    "def prep_cohort(df):\n",
    "    df = add_replicate_cols(df)\n",
    "    df['log10_RAAS'] = df[raas_col]\n",
    "    return df.replace([np.inf, -np.inf], np.nan).dropna(subset=['log10_RAAS'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 144,
   "id": "8c5b1b08",
   "metadata": {},
   "outputs": [],
   "source": [
    "## normalize_logfc\n",
    "# Per-SAAP log2FC of each replicate vs the CTRL mean\n",
    "def normalize_logfc(cohort_df):\n",
    "    # Per-SAAP log2 fold change of each replicate relative to the CTRL mean.\n",
    "    df = cohort_df.copy()\n",
    "    ctrl_means = (df[df['Disease'] == ctrl_label].groupby(SAAP_KEYS)['log10_RAAS']\n",
    "                  .mean().rename('ctrl_mean').reset_index())\n",
    "    df = df.merge(ctrl_means, on=SAAP_KEYS, how='left')\n",
    "    df['log2FC'] = (df['log10_RAAS'] - df['ctrl_mean']) * np.log2(10)\n",
    "    return df.dropna(subset=['log2FC'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 145,
   "id": "39026c45",
   "metadata": {},
   "outputs": [],
   "source": [
    "## compute_saap_stats\n",
    "# Per-SAAP Welch t-test (each disease vs CTRL) + BH-FDR per comparison\n",
    "def compute_saap_stats(cohort_df):\n",
    "    # Per-SAAP Welch t-test (each disease vs CTRL), BH-FDR within each comparison.\n",
    "    diseases = [d for d in disease_order if d in cohort_df['Disease'].unique()]\n",
    "    neuro = [d for d in diseases if d != ctrl_label]\n",
    "    frames = []\n",
    "    for cmp in neuro:\n",
    "        rows = []\n",
    "        for keys, grp in cohort_df.groupby(SAAP_KEYS, observed=True):\n",
    "            ctrl_v = grp.loc[grp['Disease'] == ctrl_label, 'log10_RAAS'].dropna().values\n",
    "            cmp_v = grp.loc[grp['Disease'] == cmp, 'log10_RAAS'].dropna().values\n",
    "            if len(ctrl_v) < min_reps or len(cmp_v) < min_reps:\n",
    "                continue\n",
    "            _, p = ttest_ind(cmp_v, ctrl_v, equal_var=False)\n",
    "            log2fc = (np.mean(cmp_v) - np.mean(ctrl_v)) * np.log2(10)\n",
    "            rows.append({'MTP_seq': keys[0], 'BP_seq': keys[1], 'aa_sub': keys[2],\n",
    "                         'comparison': cmp, 'mean_log2FC': log2fc, 'p_value': p})\n",
    "        cdf = pd.DataFrame(rows)\n",
    "        if not cdf.empty:\n",
    "            cdf = run_fdr(cdf, p_col='p_value', out_col='FDR')\n",
    "        frames.append(cdf)\n",
    "    return (pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()), neuro"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 146,
   "id": "e1ac313e",
   "metadata": {},
   "outputs": [],
   "source": [
    "## compute_aas_stats\n",
    "# Substitution-type Welch t-test vs CTRL + BH-FDR per comparison\n",
    "def compute_aas_stats(cohort_df):\n",
    "    # Substitution-type (aa_sub) Welch t-test vs CTRL + BH-FDR (two-sided).\n",
    "    diseases = [d for d in disease_order if d in cohort_df['Disease'].unique()]\n",
    "    neuro = [d for d in diseases if d != ctrl_label]\n",
    "    frames = []\n",
    "    for cmp in neuro:\n",
    "        rows = []\n",
    "        for aas, grp in cohort_df.groupby('aa_sub', observed=True):\n",
    "            ctrl_v = grp.loc[grp['Disease'] == ctrl_label, 'log10_RAAS'].dropna().values\n",
    "            cmp_v = grp.loc[grp['Disease'] == cmp, 'log10_RAAS'].dropna().values\n",
    "            if len(ctrl_v) < min_reps or len(cmp_v) < min_reps:\n",
    "                continue\n",
    "            _, p = ttest_ind(cmp_v, ctrl_v, equal_var=False)\n",
    "            log2fc = (np.mean(cmp_v) - np.mean(ctrl_v)) * np.log2(10)\n",
    "            rows.append({'aa_sub': aas, 'comparison': cmp, 'mean_log2FC': log2fc, 'p_value': p})\n",
    "        cdf = pd.DataFrame(rows)\n",
    "        if not cdf.empty:\n",
    "            cdf = run_fdr(cdf, p_col='p_value', out_col='q_value')\n",
    "        frames.append(cdf)\n",
    "    return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 147,
   "id": "8b363d25",
   "metadata": {},
   "outputs": [],
   "source": [
    "## build_cohort\n",
    "# Compute and cache the SAAP-level stats (+ shared significance set / swap-type colors)\n",
    "# that every downstream 4-block reuses for one cohort.\n",
    "def significant_saap_stats(stats):\n",
    "    # SAAP-level \"significant\" rows — the SINGLE rule shared by the 4a heatmap and the 4b-4g\n",
    "    # blocks so every section-4 figure describes the same set of SAAPs.\n",
    "    if stats is None or stats.empty:\n",
    "        return pd.DataFrame()\n",
    "    return stats[(stats[sel_metric] <= sel_thresh) &\n",
    "                 (stats['mean_log2FC'].abs() >= min_abs_log2fc)].copy()\n",
    "\n",
    "\n",
    "def swap_palette(aa_subs):\n",
    "    # Deterministic color per substitution (swap) type, shared by every section-4 figure so a\n",
    "    # given swap is always the same color. Built over ALL cohort swaps; falls back to evenly\n",
    "    # spaced hues if there are more swaps than the qualitative colormaps provide.\n",
    "    aa_subs = sorted({a for a in aa_subs if pd.notna(a)})\n",
    "    base = (list(plt.get_cmap('tab20').colors) + list(plt.get_cmap('tab20b').colors)\n",
    "            + list(plt.get_cmap('tab20c').colors))\n",
    "    if len(aa_subs) > len(base):\n",
    "        base = [plt.get_cmap('hsv')(i / len(aa_subs)) for i in range(len(aa_subs))]\n",
    "    return {a: base[i] for i, a in enumerate(aa_subs)}\n",
    "\n",
    "\n",
    "def build_cohort(cohort_df, cohort_name, with_aas=False):\n",
    "    # Compute (and cache) the stats every downstream block needs for one cohort.\n",
    "    cohort_df = filter_complete_saaps(cohort_df)                       # complete SAAPs per cohort\n",
    "    stats, neuro = compute_saap_stats(cohort_df)\n",
    "    if not stats.empty:\n",
    "        stats['SAAP'] = stats['aa_sub'] + ' | ' + stats['MTP_seq']\n",
    "        stats.to_csv(f'{PLOT_DIR}SAAP_replicate_ttest_{cohort_name}.tsv', sep='\\t', index=False)\n",
    "    sig_stats = significant_saap_stats(stats)                          # heatmap/volcano/scatter share this\n",
    "    entry = {'df': cohort_df, 'name': cohort_name, 'stats': stats, 'neuro': neuro,\n",
    "             'sig_stats': sig_stats,\n",
    "             'swap_colors': swap_palette(cohort_df['aa_sub'].unique()),  # stable across 4b-4g\n",
    "             'aas_stats': None, 'highlight_aas': None, 'volcano_cmp': None}\n",
    "    if with_aas:\n",
    "        aas_stats = compute_aas_stats(cohort_df)                       # substitution-type table (reference TSV)\n",
    "        if not aas_stats.empty:\n",
    "            aas_stats.to_csv(f'{PLOT_DIR}AAS_ttest_{cohort_name}.tsv', sep='\\t', index=False)\n",
    "            strongest = aas_stats.loc[aas_stats['q_value'].idxmin()]   # auto-pick top signal\n",
    "            entry['highlight_aas'] = strongest['aa_sub']\n",
    "            entry['volcano_cmp'] = strongest['comparison']\n",
    "        entry['aas_stats'] = aas_stats\n",
    "    return entry\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 148,
   "id": "ca345da8",
   "metadata": {},
   "outputs": [],
   "source": [
    "## plot_cohort_sig_heatmap\n",
    "# Build the significant-SAAP matrix for a cohort and draw its heatmap\n",
    "def plot_cohort_sig_heatmap(cohort):\n",
    "    # Significant-SAAP matrix: per-disease mean log2(RAAS/CTRL), sorted by neuro mean.\n",
    "    # Uses the cohort's cached sig_stats (significant_saap_stats) so the SAAPs shown here are\n",
    "    # EXACTLY the ones highlighted in the 4b volcano and plotted in the 4c scatter.\n",
    "    cohort_df, cohort_name, neuro = cohort['df'], cohort['name'], cohort['neuro']\n",
    "    if cohort['stats'].empty:\n",
    "        print(f'[{cohort_name}] no testable SAAPs.'); return\n",
    "    sig = cohort['sig_stats']\n",
    "    sig_saaps = sig['SAAP'].unique().tolist() if not sig.empty else []\n",
    "    if not sig_saaps:\n",
    "        print(f'[{cohort_name}] none pass {sel_metric}<={sel_thresh} & |log2FC|>={min_abs_log2fc}; no heatmap.'); return\n",
    "    norm = normalize_logfc(cohort_df)\n",
    "    norm['SAAP'] = norm['aa_sub'] + ' | ' + norm['MTP_seq']\n",
    "    matrix = (norm[norm['SAAP'].isin(sig_saaps)]\n",
    "              .pivot_table(index='SAAP', columns='Disease', values='log2FC', aggfunc='mean')\n",
    "              .reindex(columns=disease_order))\n",
    "    matrix = matrix.reindex(index=matrix[neuro].mean(axis=1).sort_values(ascending=False).index)\n",
    "    print(f'[{cohort_name}] {len(sig_saaps)} SAAPs | '\n",
    "          f'displayed max |log2FC| = {np.nanmax(np.abs(matrix.values)):.1f}')\n",
    "    plot_saap_sig_heatmap(matrix, cohort_name)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 149,
   "id": "32be4685",
   "metadata": {},
   "outputs": [],
   "source": [
    "## analyze_cohort\n",
    "# Per-cohort subtype analysis: Friedman (complete SAAPs) + pairwise Wilcoxon (partial)\n",
    "def analyze_cohort(cohort_df, cohort_name):\n",
    "    cohort_df = filter_complete_saaps(cohort_df)                       # complete SAAPs per cohort\n",
    "    plot_df = cohort_df.copy()\n",
    "    diseases = [d for d in disease_order if d in plot_df['Disease'].unique()]\n",
    "    neuro = [d for d in diseases if d != ctrl_label]\n",
    "\n",
    "    # Median RAAS per unique SAAP within disease, then SAAP x disease matrix\n",
    "    saap_keys = ['Disease', 'MTP_seq', 'BP_seq', 'aa_sub']\n",
    "    saap_median = (plot_df.groupby(saap_keys, observed=True)['log10_RAAS']\n",
    "                   .median().reset_index(name='med'))\n",
    "    saap_median['SAAP_ID'] = (saap_median[['MTP_seq', 'BP_seq', 'aa_sub']]\n",
    "                              .astype(str).agg('|'.join, axis=1))\n",
    "\n",
    "    wide = (saap_median.pivot_table(index=['aa_sub', 'SAAP_ID'], columns='Disease',\n",
    "                                    values='med', observed=True)\n",
    "            .reindex(columns=diseases))\n",
    "\n",
    "    # Presence-based SAAP partition (no overlap between the two analyses)\n",
    "    complete_mask = wide[diseases].notna().all(axis=1)\n",
    "    incomplete_mask = (wide[ctrl_label].notna()\n",
    "                       & wide[neuro].notna().any(axis=1)\n",
    "                       & ~complete_mask)\n",
    "\n",
    "    # ════════════════════════════════════════════════════════════════════════\n",
    "    # ANALYSIS 1 — Friedman: SAAPs present in ALL disease groups\n",
    "    # Non-parametric repeated-measures; each SAAP is a block across conditions.\n",
    "    # ════════════════════════════════════════════════════════════════════════\n",
    "    complete = wide[complete_mask]\n",
    "    rows = []\n",
    "    for aa_sub, block in complete.groupby(level='aa_sub'):\n",
    "        if len(block) < min_saap:\n",
    "            continue\n",
    "        try:\n",
    "            stat, p = friedmanchisquare(*[block[d].values for d in diseases])\n",
    "        except ValueError:\n",
    "            continue\n",
    "        rows.append({'aa_sub': aa_sub, 'n_saap': len(block),\n",
    "                     'friedman_stat': stat, 'pval': p})\n",
    "\n",
    "    fried_df = pd.DataFrame(rows)\n",
    "    if not fried_df.empty:\n",
    "        fried_df = run_fdr(fried_df, p_col='pval')\n",
    "        fried_df['Significance'] = fried_df['FDR'].apply(add_sig_label)\n",
    "\n",
    "        # log2FC vs CTRL per (aa_sub, disease) from complete SAAPs\n",
    "        aas_med = complete.groupby(level='aa_sub').median()\n",
    "        fc1 = aas_med.sub(aas_med[ctrl_label], axis=0) * np.log2(10)\n",
    "        fried_df['max_abs_log2FC'] = fried_df['aa_sub'].map(fc1[neuro].abs().max(axis=1))\n",
    "        fried_df = fried_df.sort_values(['FDR', 'pval'])\n",
    "        fried_df.to_csv(f'{PLOT_DIR}friedman_complete_SAAPs_{cohort_name}.tsv',\n",
    "                        sep='\\t', index=False)\n",
    "\n",
    "        sig1 = fried_df[(fried_df['FDR'] < fdr_thresh)\n",
    "                        & (fried_df['max_abs_log2FC'] >= min_abs_log2fc)]['aa_sub'].tolist()\n",
    "        print(f'[{cohort_name}] Friedman tested: {len(fried_df)} | '\n",
    "              f'FDR<{fdr_thresh} & |log2FC|>={min_abs_log2fc}: {len(sig1)}')\n",
    "\n",
    "        order1 = (fc1.loc[sig1, neuro].mean(axis=1).sort_values(ascending=False).index\n",
    "                  if sig1 else [])\n",
    "        mat1 = fc1.reindex(index=order1, columns=diseases)\n",
    "        plot_subtype_sig_heatmap(mat1, cohort_name, 'Friedman (complete SAAPs)',\n",
    "                         'Disease', f'friedman_complete_heatmap_{cohort_name}.pdf')\n",
    "    else:\n",
    "        print(f'[{cohort_name}] Friedman: no aa_sub with complete blocks.')\n",
    "\n",
    "    # ════════════════════════════════════════════════════════════════════════\n",
    "    # ANALYSIS 2 — Pairwise Wilcoxon: SAAPs in CTRL + >=1 neurodegen, NOT all.\n",
    "    # Each neurodegen group vs CTRL on shared SAAPs (paired, non-parametric);\n",
    "    # an aa_sub is significant if >=1 comparison qualifies.\n",
    "    # ════════════════════════════════════════════════════════════════════════\n",
    "    incomplete = wide[incomplete_mask]\n",
    "    rows = []\n",
    "    for aa_sub, block in incomplete.groupby(level='aa_sub'):\n",
    "        for g in neuro:\n",
    "            pair = block[[ctrl_label, g]].dropna()\n",
    "            if len(pair) < min_saap:\n",
    "                continue\n",
    "            if np.all(pair[g].values - pair[ctrl_label].values == 0):\n",
    "                continue\n",
    "            try:\n",
    "                stat, p = wilcoxon(pair[ctrl_label].values, pair[g].values)\n",
    "            except ValueError:\n",
    "                continue\n",
    "            log2fc = (np.median(pair[g].values)\n",
    "                      - np.median(pair[ctrl_label].values)) * np.log2(10)\n",
    "            rows.append({'aa_sub': aa_sub, 'comparison': f'{g}_vs_{ctrl_label}',\n",
    "                         'n_pairs': len(pair), 'wilcoxon_stat': stat,\n",
    "                         'pval': p, 'log2FC_vs_CTRL': log2fc})\n",
    "\n",
    "    pair_df = pd.DataFrame(rows)\n",
    "    if not pair_df.empty:\n",
    "        pair_df = run_fdr(pair_df, p_col='pval')\n",
    "        pair_df['Significance'] = pair_df['FDR'].apply(add_sig_label)\n",
    "        pair_df = pair_df.sort_values(['FDR', 'pval'])\n",
    "        pair_df.to_csv(f'{PLOT_DIR}pairwise_partial_SAAPs_{cohort_name}.tsv',\n",
    "                       sep='\\t', index=False)\n",
    "\n",
    "        qualifying = pair_df[(pair_df['FDR'] < fdr_thresh)\n",
    "                             & (pair_df['log2FC_vs_CTRL'].abs() >= min_abs_log2fc)]\n",
    "        sig2 = qualifying['aa_sub'].unique().tolist()\n",
    "        print(f'[{cohort_name}] Pairwise comparisons: {len(pair_df)} | '\n",
    "              f'aa_subs with >=1 qualifying comparison: {len(sig2)}')\n",
    "\n",
    "        mat2 = (pair_df[pair_df['aa_sub'].isin(sig2)]\n",
    "                .pivot_table(index='aa_sub', columns='comparison',\n",
    "                             values='log2FC_vs_CTRL', observed=True)\n",
    "                .reindex(columns=[f'{g}_vs_{ctrl_label}' for g in neuro]))\n",
    "        if not mat2.empty:\n",
    "            mat2 = mat2.reindex(index=mat2.mean(axis=1).sort_values(ascending=False).index)\n",
    "        plot_subtype_sig_heatmap(mat2, cohort_name, 'Pairwise Wilcoxon (partial SAAPs)',\n",
    "                         'Comparison', f'pairwise_partial_heatmap_{cohort_name}.pdf')\n",
    "    else:\n",
    "        print(f'[{cohort_name}] Pairwise: no aa_sub with partial-presence SAAPs.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 150,
   "id": "36a8f899",
   "metadata": {},
   "outputs": [],
   "source": [
    "## tissue_ctrl_log2fc_anova\n",
    "# Per (tissue, aa_sub): log2 fold change of median RAAS vs the tissue-specific CTRL\n",
    "# baseline, plus a one-way ANOVA of RAAS across disease groups.\n",
    "#   collapse_saap=True  -> aggregate to per-SAAP medians first (>= min_saap_per_aas SAAPs)\n",
    "#   collapse_saap=False -> replicate-level (no SAAP collapsing)\n",
    "# Returns (norm_df, anova_df, sig_pairs).\n",
    "def tissue_ctrl_log2fc_anova(sub_df, *, collapse_saap=True, top_n=15):\n",
    "    sub_df = add_replicate_cols(sub_df)\n",
    "    sub_df['log10_RAAS'] = sub_df[raas_col]\n",
    "    sub_df = sub_df.replace([np.inf, -np.inf], np.nan).dropna(subset=['log10_RAAS'])\n",
    "    sub_df = filter_complete_saaps(sub_df, within=['Tissue'])          # complete SAAPs per tissue\n",
    "    tissue_order = sorted(sub_df['Tissue'].dropna().unique())\n",
    "\n",
    "    # top substitutions per tissue (union), using unique SAAP identities\n",
    "    top_subs = []\n",
    "    for tissue in tissue_order:\n",
    "        top_subs += (sub_df[sub_df['Tissue'] == tissue][SAAP_KEYS].drop_duplicates()\n",
    "                     ['aa_sub'].value_counts().head(top_n).index.tolist())\n",
    "    top_subs = list(dict.fromkeys(top_subs))\n",
    "\n",
    "    plot_df = sub_df[sub_df['aa_sub'].isin(top_subs)].copy()\n",
    "    sub_order = plot_df['aa_sub'].value_counts().reindex(top_subs).dropna().index\n",
    "    plot_df['aa_sub'] = pd.Categorical(plot_df['aa_sub'], categories=sub_order, ordered=True)\n",
    "    plot_df['Tissue'] = pd.Categorical(plot_df['Tissue'], categories=tissue_order, ordered=True)\n",
    "    plot_df['Disease'] = pd.Categorical(plot_df['Disease'], categories=disease_order, ordered=True)\n",
    "\n",
    "    if collapse_saap:\n",
    "        saap_keys = ['Tissue', 'Disease'] + SAAP_KEYS\n",
    "        level_df = (plot_df.groupby(saap_keys, observed=False)['log10_RAAS']\n",
    "                    .median().reset_index(name='val'))\n",
    "        counts = (level_df.groupby(['Tissue', 'Disease', 'aa_sub'], observed=False)\n",
    "                  .size().reset_index(name='n_saap'))\n",
    "        valid = counts[counts['n_saap'] >= min_saap_per_aas][['Tissue', 'Disease', 'aa_sub']]\n",
    "        level_df = level_df.merge(valid, on=['Tissue', 'Disease', 'aa_sub'], how='inner')\n",
    "    else:\n",
    "        level_df = plot_df.rename(columns={'log10_RAAS': 'val'})\n",
    "\n",
    "    # one-way ANOVA across disease groups within each tissue + aa_sub\n",
    "    rows = []\n",
    "    for tissue in tissue_order:\n",
    "        tissue_df = level_df[level_df['Tissue'] == tissue]\n",
    "        for aa_sub in sub_order:\n",
    "            aas_df = tissue_df[tissue_df['aa_sub'] == aa_sub]\n",
    "            groups = [aas_df[aas_df['Disease'] == d]['val'].dropna().values for d in disease_order]\n",
    "            groups = [g for g in groups if len(g) >= 2]\n",
    "            if len(groups) >= 2:\n",
    "                f_stat, p_val = stats.f_oneway(*groups)\n",
    "                rows.append({'Tissue': tissue, 'aa_sub': aa_sub,\n",
    "                             'F_statistic': f_stat, 'p_value': p_val})\n",
    "    anova_df = run_fdr(pd.DataFrame(rows), p_col='p_value')\n",
    "\n",
    "    # median val per (tissue, disease, aa_sub) and tissue-specific CTRL baseline -> log2FC\n",
    "    aas_median_df = (level_df.groupby(['Tissue', 'Disease', 'aa_sub'], observed=False)['val']\n",
    "                     .median().reset_index(name='AAS_median_log10_RAAS'))\n",
    "    ctrl_df = (aas_median_df[aas_median_df['Disease'] == ctrl_label]\n",
    "               [['Tissue', 'aa_sub', 'AAS_median_log10_RAAS']]\n",
    "               .rename(columns={'AAS_median_log10_RAAS': 'CTRL_AAS_median_log10_RAAS'}))\n",
    "    norm_df = aas_median_df.merge(ctrl_df, on=['Tissue', 'aa_sub'], how='left')\n",
    "    norm_df['log2FC_vs_CTRL'] = ((norm_df['AAS_median_log10_RAAS']\n",
    "                                  - norm_df['CTRL_AAS_median_log10_RAAS']) * np.log2(10))\n",
    "    norm_df = (norm_df.dropna(subset=['log2FC_vs_CTRL'])\n",
    "               .merge(anova_df, on=['Tissue', 'aa_sub'], how='left'))\n",
    "\n",
    "    # (tissue, aa_sub) pairs passing both |log2FC| and FDR thresholds\n",
    "    sig_pairs = (norm_df.groupby(['Tissue', 'aa_sub'], observed=False)['log2FC_vs_CTRL']\n",
    "                 .apply(lambda x: np.nanmax(np.abs(x.values)))\n",
    "                 .reset_index(name='max_abs_log2FC')\n",
    "                 .merge(anova_df, on=['Tissue', 'aa_sub'], how='left'))\n",
    "    sig_pairs = sig_pairs[(sig_pairs['max_abs_log2FC'] > min_abs_log2fc)\n",
    "                          & (sig_pairs['FDR'] < fdr_thresh)]\n",
    "    return norm_df, anova_df, sig_pairs\n"
   ]
  },
