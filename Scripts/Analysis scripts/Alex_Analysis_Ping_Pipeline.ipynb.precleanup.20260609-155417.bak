    "# SAAP PEP distribution\n",
    "fig,ax=plt.subplots(figsize=(5,4))\n",
    "pep_df=SAAP_quant_df['SAAP_PEP']\n",
    "pep_df=(pep_df).replace([np.inf,-np.inf],np.nan).dropna()\n",
