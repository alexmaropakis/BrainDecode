    "## BLASTp filtering and IDs "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 153,
   "id": "29f10d49",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BLASTp candidate SAAPs: 898\n",
      "status\n",
      "keep              800\n",
      "drop_no_parent     82\n",
      "drop_reference      6\n",
      "drop_trypsin        5\n",
      "drop_ig             5\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "# read in BLASTp data for mapping SAAPs to proteins and genes\n",
    "# Every candidate SAAP (MTP) is BLASTed against the reference proteome to confirm a parent\n",
    "# protein and substitution position. status == 'keep' passes QC; drop_* are removed\n",
    "# (no parent found, matches reference, tryptic artefact, or immunoglobulin). The *_filtered\n",
    "# file is the 'keep' subset. Keys are renamed to match SAAP_quant_df for the merge below.\n",
    "BLAST_DIR = CODE_DIR + 'BLASTp/'\n",
    "blast_key = {'dataset': 'Dataset', 'mtp_seq': 'MTP_seq', 'bp_seq': 'BP_seq'}\n",
    "blast_unfiltered = pd.read_csv(BLAST_DIR + 'June26_human_unfiltered.csv').rename(columns=blast_key)\n",
    "blast_filtered   = pd.read_csv(BLAST_DIR + 'June26_human_filtered.csv').rename(columns=blast_key)\n",
    "\n",
    "print(f'BLASTp candidate SAAPs: {len(blast_unfiltered):,}')\n",
    "print(blast_unfiltered['status'].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 154,
   "id": "fdb07983",
   "metadata": {},
   "outputs": [
    {
     "data": {
