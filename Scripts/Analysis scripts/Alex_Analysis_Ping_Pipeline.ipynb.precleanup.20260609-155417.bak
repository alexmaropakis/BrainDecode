   "source": [
    "# One-way ANOVA + Tukey HSD of RAAS across tissues, per substitution type (replicate-level)\n",
    "run_anova_by_tissue(\n",
    "    sub_df=add_replicate_cols(SAAP_quant_df_grouped),\n",
    "    outfile=OUTDIR + 'ANOVAwTukey_RAASBetweenTissuesperAASType_REPLICATE_LEVEL.tsv')\n"
   ]
