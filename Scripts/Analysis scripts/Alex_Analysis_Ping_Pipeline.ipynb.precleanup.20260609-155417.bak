   "cell_type": "code",
   "execution_count": 209,
   "id": "sharedpepscaffold",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Shared-peptide analysis: setup (reference proteome + helpers) ──────────────\n",
    "import ast, re\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "FASTA_PATH   = PROJ_DIR + 'mq_output/HUMAN.fasta'   # BLAST reference proteome (UniProt FASTA)\n",
    "POS_PROB_MIN = 0.0     # raise (e.g. 0.95) to restrict to confidently-localized SAAPs\n",
    "MIN_SHARED   = 2       # min shared peptides required to keep a SAAP's protein\n",
    "\n",
    "def mq_peptides_path(ds):\n",
    "    \"\"\"MaxQuant peptides.txt for a TMT set: 'acgb1' -> .../acg/b1/peptides.txt.\"\"\"\n",
    "    tissue = 'acg' if ds.startswith('acg') else 'fc'\n",
    "    return MQ_DIR + f'{tissue}/{ds[len(tissue):]}/peptides.txt'\n",
    "\n",
    "def parse_proteome(path):\n",
    "    \"\"\"UniProt FASTA -> ({accession: sequence}, {accession: header}).\"\"\"\n",
    "    seqs, desc, acc, buf = {}, {}, None, []\n",
    "    for line in open(path):\n",
    "        if line.startswith('>'):\n",
    "            if acc: seqs[acc] = ''.join(buf)\n",
    "            head = line[1:].strip(); parts = head.split('|')\n",
    "            acc = parts[1] if len(parts) >= 2 else head.split()[0]\n",
    "            desc[acc], buf = head, []\n",
    "        else:\n",
    "            buf.append(line.strip())\n",
    "    if acc: seqs[acc] = ''.join(buf)\n",
    "    return seqs, desc\n",
    "\n",
    "# parse once and cache (HUMAN.fasta is ~45 MB)\n",
    "if 'PROT_SEQS' not in globals():\n",
    "    PROT_SEQS, PROT_DESC = parse_proteome(FASTA_PATH)\n",
    "    print(f'reference proteins parsed: {len(PROT_SEQS):,}')\n",
    "PROT_BASE = {a.split('-')[0]: a for a in PROT_SEQS}        # isoform-stripped fallback\n",
    "\n",
    "def acc_to_seq(accession):\n",
    "    \"\"\"Reference accession -> (canonical key, sequence), tolerating isoform suffixes (e.g. Q14194-2).\"\"\"\n",
    "    a = accession if accession in PROT_SEQS else PROT_BASE.get(str(accession).split('-')[0])\n",
    "    return (a, PROT_SEQS[a]) if a else (None, None)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 210,
   "id": "sharedpep_build",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "546 SAAP rows across 198 genes -> /Users/alexmaropakis/Projects/BrainDecode/Dependencies/Analysis_Outputs/Ping_2018/Plotted_shared_peptide_data.xlsx\n"
     ]
    }
   ],
   "source": [
    "# ── Assemble the shared-peptide table (one row per Dataset × SAAP) ─────────────\n",
    "# For each detected SAAP: source protein (BLASTp keep set) -> protein sequence, and every OTHER\n",
    "# MaxQuant-detected peptide of that protein (\"shared peptides\", present in both proteoforms) with\n",
    "# its intensity. SAAP/BP precursor abundances + RAAS are summarized per SAAP from SAAP_quant_df.\n",
    "smap = (blast_filtered[['MTP_seq', 'BP_seq', 'gene', 'accession']]\n",
    "        .drop_duplicates(['MTP_seq', 'BP_seq']))\n",
    "\n",
    "rows = []\n",
    "for ds in datasets:\n",
    "    # detected peptides per protein in this TMT set: base accession -> [(sequence, intensity), ...]\n",
    "    pep = pd.read_csv(mq_peptides_path(ds), sep='\\t',\n",
    "                      usecols=['Sequence', 'Leading razor protein', 'Intensity'])\n",
    "    pep['accb'] = (pep['Leading razor protein'].str.split('|').str[1]\n",
    "                   .fillna(pep['Leading razor protein']).str.split('-').str[0])\n",
    "    prot2pep = {a: list(zip(g['Sequence'], g['Intensity'])) for a, g in pep.groupby('accb')}\n",
    "\n",
    "    # one representative value per SAAP (median RAAS, mean precursor abundance) in this set\n",
    "    agg = (SAAP_quant_df[SAAP_quant_df['Dataset'] == ds].replace([np.inf, -np.inf], np.nan)\n",
    "           .groupby(['MTP_seq', 'BP_seq', 'aa_sub'], as_index=False)\n",
    "           .agg(RAAS=('Reporter_RAAS', 'median'), SAAP_ab=('MTP_PrecInt', 'mean'),\n",
    "                BP_ab=('BP_PrecInt', 'mean'), pos_prob=('Positional_probability', 'max'))\n",
    "           .merge(smap, on=['MTP_seq', 'BP_seq'], how='inner'))\n",
    "    agg = agg[agg['pos_prob'] >= POS_PROB_MIN]\n",
    "\n",
    "    for _, r in agg.iterrows():\n",
    "        key, protseq = acc_to_seq(r['accession'])\n",
    "        if protseq is None or r['BP_seq'] not in protseq:          # need the protein, with the BP in it\n",
    "            continue\n",
    "        shared = [(s, i) for s, i in prot2pep.get(key.split('-')[0], [])\n",
    "                  if isinstance(s, str) and s in protseq]           # peptides truly within the protein\n",
    "        if len(shared) < MIN_SHARED:\n",
    "            continue\n",
    "        rows.append({'Dataset': ds, 'SAAP': r['MTP_seq'], 'BP': r['BP_seq'], 'AAS': r['aa_sub'],\n",
    "                     'RAAS': r['RAAS'], 'Positional_probability': r['pos_prob'],\n",
    "                     'SAAP abund no IE norm': r['SAAP_ab'], 'BP abund no IE norm': r['BP_ab'],\n",
    "                     'Gene': r['gene'], 'Uniprot_ID': key, 'Reference protein': PROT_DESC.get(key, ''),\n",
    "                     'Protein_sequence': protseq,\n",
    "                     'Used_shared_peptides': [s for s, i in shared],\n",
    "                     'Fixed_peptide_intensities': [i for s, i in shared],\n",
    "                     'N_used_shared_peptides': len(shared)})\n",
    "\n",
    "filt_saap2plot_df = pd.DataFrame(rows)\n",
    "filt_saap2plot_df.to_excel(OUTDIR + 'Plotted_shared_peptide_data.xlsx', index=False)\n",
    "print(f'{len(filt_saap2plot_df):,} SAAP rows across {filt_saap2plot_df[\"Gene\"].nunique():,} genes '\n",
    "      f'-> {OUTDIR}Plotted_shared_peptide_data.xlsx')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 211,
   "id": "sharedpep_plotfn",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Plot: peptide abundance vs protein position (shared peptides + SAAP + BP) ──\n",
    "def _pep_range(pep, protseq):\n",
    "    \"\"\"Last match range of a peptide within the protein sequence.\"\"\"\n",
    "    m = list(re.compile(re.escape(pep)).finditer(protseq))\n",
    "    return (m[-1].start(), m[-1].end()) if m else (0, 0)\n",
    "\n",
    "def plot_shared_peptides(saap2plot_df, gene, outdir=PLOT_DIR):\n",
    "    rows = saap2plot_df[saap2plot_df['Gene'] == gene]\n",
    "    if rows.empty:\n",
    "        print(f'{gene}: not in table'); return\n",
    "    row = rows.iloc[0]\n",
    "    protseq, bp = row['Protein_sequence'], row['BP']\n",
    "    # tolerate either python objects (in-memory df) or stringified lists (re-read from xlsx)\n",
    "    peps  = ast.literal_eval(row['Used_shared_peptides'])      if isinstance(row['Used_shared_peptides'], str)      else row['Used_shared_peptides']\n",
    "    pints = ast.literal_eval(row['Fixed_peptide_intensities']) if isinstance(row['Fixed_peptide_intensities'], str) else row['Fixed_peptide_intensities']\n",
    "    if bp not in protseq:\n",
    "        print(f'{gene}: BP not in protein sequence'); return\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(7, 2)); ax.set_xlim(0, len(protseq)); ax.set_yscale('log')\n",
    "    first = True\n",
    "    for pp, ii in zip(peps, pints):                            # shared peptides (exclude the BP)\n",
    "        if pp == bp or pd.isna(ii) or ii <= 0 or pp not in protseq:\n",
    "            continue\n",
    "        s, e = _pep_range(pp, protseq)\n",
    "        ax.plot((s, e), (ii, ii), color=ACG_color, label='Shared peptide' if first else None); first = False\n",
    "    bs, be = _pep_range(bp, protseq)                           # SAAP and BP at the substitution site\n",
    "    ax.plot((bs, be), (row['SAAP abund no IE norm'],) * 2, color=COLOR_UP, lw=2, label='SAAP')\n",
    "    ax.plot((bs, be), (row['BP abund no IE norm'],) * 2, color=COLOR_DOWN, lw=2, label='BP')\n",
    "    ax.set_xlabel('Amino acid position', fontsize=14); ax.set_ylabel('Peptide abundance', fontsize=14)\n",
    "    ax.tick_params('both', labelsize=12); despine()\n",
    "    h, l = ax.get_legend_handles_labels()\n",
    "    h += [Line2D([], [], c='w')]; l += [r'log$_{10}$(RAAS) = ' + f\"{row['RAAS']:.2f}\"]\n",
    "    ax.legend(handles=h, labels=l, bbox_to_anchor=(1, 1), fontsize=9)\n",
    "    ax.set_title(f'{gene}', fontsize=13)\n",
    "    fig.savefig(f\"{outdir}{str(gene).replace('/', '_')}_shared_peptides.pdf\", bbox_inches='tight'); plt.show()"
   ]
  },
