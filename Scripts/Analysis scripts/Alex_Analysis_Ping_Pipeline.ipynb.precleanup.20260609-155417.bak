   "source": [
    "# Median RAAS per tissue across disease states, using each tissue's most frequent\n",
    "# substitutions (union of per-tissue top 15). Columns ordered ACG (b1-5) then FC (b2-5).\n",
    "plot_raas_tissue_disease_heatmap(\n",
    "    SAAP_quant_df_grouped, 'Median RAAS per tissue for tissue-specific top AAS',\n",
    "    'top_substitution_ReporterRAAS_Disease_changes_tissue_heatmap.pdf',\n",
    "    figsize=(20, 20), per_tissue=True)\n"
   ]
  },
