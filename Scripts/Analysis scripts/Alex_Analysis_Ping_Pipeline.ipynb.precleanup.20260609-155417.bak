   "id": "refprot_go_enrich",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1421 GO:BP terms tested (5,323 obs); 47 significantly HIGH RAAS (t>0, p<=1e-15)\n",
      "                                                               GO term  N obs  median RAAS             p\n",
      "0                                         ion homeostasis (GO:0050801)     16     0.895405  4.266509e-16\n",
      "1                                    chemical homeostasis (GO:0048878)     16     0.895405  4.266509e-16\n",
      "2  positive regulation of actin filament depolymerization (GO:0030836)     46     0.694755  1.158191e-17\n",
      "3                                  sarcomere organization (GO:0045214)     54     0.518522  3.594407e-16\n",
      "4           regulation of canonical Wnt signaling pathway (GO:0060828)     36     0.455443  2.482015e-20\n",
      "5            positive regulation of Wnt signaling pathway (GO:0030177)     36     0.455443  2.482015e-20\n",
      "6  positive regulation of canonical Wnt signaling pathway (GO:0090263)     36     0.455443  2.482015e-20\n",
      "7                                        skin development (GO:0043588)     56     0.368972  3.968308e-24\n",
      "8                             regulation of cell adhesion (GO:0030155)     16     0.363911  1.008299e-28\n",
      "9             negative regulation of cell differentiation (GO:0045596)     16     0.363911  1.008299e-28\n"
     ]
    }
   ],
   "source": [
    "# ── GO-term RAAS enrichment: which GO:BP terms carry a significantly HIGH RAAS distribution ──\n",
    "# Per-observation Reporter_RAAS mapped to GO:BP terms via each SAAP's source-protein gene; two-sided\n",
    "# Welch t-test of a term's RAAS vs all observations. \"significantly high\" = t > 0 & p <= P_SIG.\n",
    "# NOTE: per-observation pooling is anticonservative (pseudo-replication) — this reproduces the\n",
    "# paper-style P<=1e-15 method; the matrix bubble plot below shows the conservative per-SAAP-median view.\n",
    "import re, collections\n",
    "P_SIG, MIN_OBS = 1e-15, 10\n",
    "gene_by_saap = blast_filtered.dropna(subset=['accession']).drop_duplicates('MTP_seq').set_index('MTP_seq')['gene']\n",
    "obs = (SAAP_quant_df.replace([np.inf, -np.inf], np.nan).dropna(subset=['Reporter_RAAS'])[['MTP_seq', 'Reporter_RAAS']]).copy()\n",
    "obs['gene'] = obs['MTP_seq'].map(gene_by_saap); obs = obs.dropna(subset=['gene'])\n",
    "\n",
    "def _gene_terms(g):\n",
    "    return {t for tok in re.split(r'[;/,]', str(g)) for t in GENE2GO.get(tok.strip().upper(), [])}\n",
    "term_obs = collections.defaultdict(list)\n",
    "for _, raas, gene in obs.itertuples(index=False):\n",
    "    for t in _gene_terms(gene):\n",
    "        term_obs[t].append(raas)\n",
    "\n",
    "all_raas = obs['Reporter_RAAS'].values\n",
    "rows = [[term, len(v), float(np.median(v)), *sp.stats.ttest_ind(v, all_raas, equal_var=False)]\n",
    "        for term, v in term_obs.items() if len(v) >= MIN_OBS]\n",
    "go_raas = pd.DataFrame(rows, columns=['GO term', 'N obs', 'median RAAS', 't', 'p']).sort_values('p')\n",
    "go_raas['significant_high'] = (go_raas['p'] <= P_SIG) & (go_raas['t'] > 0)\n",
    "go_sig = go_raas[go_raas['significant_high']].sort_values('median RAAS', ascending=False).reset_index(drop=True)\n",
    "go_raas.to_excel(OUTDIR + 'GO_term_RAAS_enrichment.xlsx', index=False)\n",
    "print(f\"{len(go_raas)} GO:BP terms tested ({len(all_raas):,} obs); \"\n",
    "      f\"{int(go_raas['significant_high'].sum())} significantly HIGH RAAS (t>0, p<={P_SIG:g})\")\n",
    "print(go_sig.head(10)[['GO term', 'N obs', 'median RAAS', 'p']].to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 218,
   "id": "refprot_plot2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
