       "<Figure size 770x440 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 605x1265 with 10 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# gnomAD/BLASTp QC plots (each a SEPARATE figure), driven by the AF_THRESHOLD filter above.\n",
    "# Conditions: 'Removed: BLAST' = failed BLASTp source-protein assignment; 'Removed: gnomAD (common)'\n",
    "# = BLAST-kept SAAP matching a variant with AF >= AF_THRESHOLD; 'Retained' = everything else\n",
    "# (= SAAP_quant_df_AFfiltered, which carries all annotation columns).\n",
    "key = ['Dataset', 'MTP_seq', 'BP_seq']\n",
    "\n",
    "# per-SAAP-identity QC table (one row per detected SAAP), with the AF-threshold condition\n",
    "qc = (blast_unfiltered[key + ['status']].drop_duplicates(key)\n",
    "      .merge(gnomad_annotated[key + ['gnomad_af']].drop_duplicates(key), on=key, how='left'))\n",
    "qc['common'] = qc['gnomad_af'] >= AF_THRESHOLD                       # NaN (no variant) -> False\n",
    "n_candidate  = len(qc)\n",
    "n_blast_keep = int((qc['status'] == 'keep').sum())\n",
    "n_common     = int(((qc['status'] == 'keep') & qc['common']).sum())\n",
    "n_final      = n_blast_keep - n_common\n",
    "\n",
    "# ---- Plot 1: QC funnel ----\n",
    "fig, ax = plt.subplots(figsize=(4.6, 4))\n",
    "stages = ['All detected\\nSAAPs', 'Mapped to source\\nprotein (BLASTp)', f'Not a common\\nvariant (AF<{AF_THRESHOLD:g})']\n",
    "vals = [n_candidate, n_blast_keep, n_final]\n",
    "b = ax.bar(stages, vals, color=[GRAY, ACG_color, POOLED_COLOR], width=0.7)\n",
    "for r, v in zip(b, vals):\n",
    "    ax.annotate(f'{v}\\n({100 * v / n_candidate:.0f}%)', (r.get_x() + r.get_width() / 2, v),\n",
    "                ha='center', va='bottom', fontsize=9)\n",
    "ax.set_ylabel('# SAAPs', fontsize=13); ax.set_ylim(0, n_candidate * 1.2)\n",
    "ax.tick_params(axis='x', labelsize=8); despine(); ax.set_title('SAAP QC funnel', fontsize=12)\n",
    "plt.tight_layout(); plt.savefig(PLOT_DIR + 'QC_funnel.pdf', bbox_inches='tight'); plt.show()\n",
    "\n",
    "# ---- Plot 2: gnomAD allele-frequency distribution of matched SAAPs, with the cutoff marked ----\n",
    "af = gnomad_annotated.loc[gnomad_annotated['gnomad_af'] > 0, 'gnomad_af'].dropna()\n",
    "fig, ax = plt.subplots(figsize=(4.6, 3.6))\n",
    "ax.hist(np.log10(af), bins=30, color=COLOR_DOWN, edgecolor='white', linewidth=0.3)\n",
    "ax.axvline(np.log10(AF_THRESHOLD), ls='--', color='red', lw=1.5)\n",
    "n_rm = int((af >= AF_THRESHOLD).sum())\n",
    "ax.annotate(f'cutoff AF = {AF_THRESHOLD:g}\\nremoved (>= cutoff): {n_rm}\\nkept (< cutoff): {len(af) - n_rm}',\n",
    "            (0.04, 0.72), xycoords='axes fraction', fontsize=9)\n",
    "ax.set_xlabel(r'$\\log_{10}$(gnomAD allele frequency)', fontsize=12); ax.set_ylabel('# matched SAAPs', fontsize=12)\n",
    "despine(); ax.set_title('Allele frequency of variant-matched SAAPs', fontsize=11)\n",
    "plt.tight_layout(); plt.savefig(PLOT_DIR + 'QC_gnomAD_AF_distribution.pdf', bbox_inches='tight'); plt.show()\n",
    "\n",
    "# ---- Plot 3: per-TMT-set QC outcome (acgb1-5, fcb1-5) ----\n",
    "rows = []\n",
    "for ds in datasets:\n",
    "    sub = qc[qc['Dataset'] == ds]\n",
    "    keep = int((sub['status'] == 'keep').sum())\n",
    "    common = int(((sub['status'] == 'keep') & sub['common']).sum())\n",
    "    rows.append([ds, keep - common, common, len(sub) - keep])\n",
    "pq = pd.DataFrame(rows, columns=['Dataset', 'final', 'common', 'blast_drop'])\n",
    "x = np.arange(len(datasets))\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "ax.bar(x, pq['final'], color=ACG_color, label='Retained (analysis set)', edgecolor='white', linewidth=0.4)\n",
    "ax.bar(x, pq['common'], bottom=pq['final'], color=COLOR_DOWN, label=f'Removed: common variant (AF>={AF_THRESHOLD:g})', edgecolor='white', linewidth=0.4)\n",
    "ax.bar(x, pq['blast_drop'], bottom=pq['final'] + pq['common'], color=COLOR_UP, label='Removed: failed BLASTp QC', edgecolor='white', linewidth=0.4)\n",
    "ax.set_xticks(x); ax.set_xticklabels(datasets, rotation=45, fontsize=9)\n",
    "ax.set_ylabel('# SAAPs', fontsize=13); ax.legend(fontsize=8, frameon=False); despine()\n",
    "ax.set_title('SAAP QC outcome per TMT set', fontsize=12)\n",
    "plt.tight_layout(); plt.savefig(PLOT_DIR + 'QC_outcome_per_TMTset.pdf', bbox_inches='tight'); plt.show()\n",
    "\n",
    "# ---- Plot 4: per-TMT-set RAAS distribution by QC condition (shaded-KDE ridgeline) ----\n",
    "df = SAAP_quant_df_annotated.copy()\n",
    "df['log10_RAAS'] = df['Reporter_RAAS'].replace([np.inf, -np.inf], np.nan)\n",
    "_common = df['gnomad_af'] >= AF_THRESHOLD\n",
    "_bdrop = df['blast_status'] != 'keep'\n",
    "df['condition'] = np.where(_bdrop, 'Removed: BLAST',\n",
    "                           np.where(_common, 'Removed: gnomAD (common)', 'Retained'))\n",
    "conds = ['Retained', 'Removed: gnomAD (common)', 'Removed: BLAST']\n",
    "ccol = {'Retained': ACG_color, 'Removed: gnomAD (common)': COLOR_DOWN, 'Removed: BLAST': COLOR_UP}\n",
    "v = df['log10_RAAS'].dropna()\n",
    "xs = np.linspace(np.percentile(v, 0.5), np.percentile(v, 99.5), 200)\n",
    "fig, axes = plt.subplots(len(datasets), 1, sharex=True, figsize=(5.5, 1.15 * len(datasets)))\n",
    "plt.subplots_adjust(hspace=0.15)\n",
    "for ax, ds in zip(axes, datasets):\n",
    "    sub = df[df['Dataset'] == ds]\n",
    "    for c in conds:\n",
    "        vv = sub.loc[sub['condition'] == c, 'log10_RAAS'].dropna().values\n",
    "        if len(vv) >= 5:\n",
    "            k = sp.stats.gaussian_kde(vv)(xs)\n",
    "            ax.fill_between(xs, k, color=ccol[c], alpha=0.45, lw=0); ax.plot(xs, k, color=ccol[c], lw=0.7)\n",
    "    ax.set_yticks([]); ax.set_ylabel(ds, rotation=0, ha='right', va='center', fontsize=9)\n",
    "    for sp_ in ['left', 'right', 'top']: ax.spines[sp_].set_visible(False)\n",
    "axes[-1].set_xlabel(r'$\\log_{10}$(RAAS)', fontsize=12)\n",
    "handles = [plt.Rectangle((0, 0), 1, 1, color=ccol[c], alpha=0.6) for c in conds]\n",
    "axes[0].legend(handles, conds, fontsize=7, frameon=False, loc='lower right', bbox_to_anchor=(1.0, 1.15))\n",
    "fig.suptitle(f'RAAS distribution by QC outcome per TMT set (AF cutoff {AF_THRESHOLD:g})', fontsize=11, y=0.995)\n",
    "plt.tight_layout(); plt.savefig(PLOT_DIR + 'QC_RAAS_by_condition_per_TMTset.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 159,
   "id": "gnomadrasscatter",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 660x440 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Scatter 1 — pooled ACG+FC log10(RAAS) vs log10(gnomAD allele frequency), one point per SAAP.\n",
    "# Sourced from SAAP_quant_df_annotated. ALL SAAPs are shown: variant-matched SAAPs at their real\n",
    "# allele frequency; SAAPs with no gnomAD variant (no AF) are jittered in a band at the left \"AF=0\"\n",
    "# floor so their RAAS still appears. Colored by the AF filter: retained (in SAAP_quant_df_AFfiltered)\n",
    "# -> pink, removed common variant (AF >= AF_THRESHOLD) -> gray. Pearson r/p is over matched SAAPs only.\n",
    "from matplotlib.lines import Line2D\n",
    "GRAY_PT= '#999999'\n",
    "\n",
    "retained_saaps = set(SAAP_quant_df_AFfiltered['MTP_seq'])\n",
    "per = (SAAP_quant_df_annotated.replace([np.inf, -np.inf], np.nan)\n",
    "       .groupby('MTP_seq', as_index=False)\n",
    "       .agg(mean_RAAS=('Reporter_RAAS', 'mean'), gnomad_af=('gnomad_af', 'max'))\n",
    "       .dropna(subset=['mean_RAAS']))\n",
    "per['retained'] = per['MTP_seq'].isin(retained_saaps)\n",
    "\n",
    "matched = per[per['gnomad_af'] > 0].copy()\n",
    "matched['log_af'] = np.log10(matched['gnomad_af'])\n",
    "nomatch = per[~(per['gnomad_af'] > 0)].copy()                       # no AF (no matched variant)\n",
    "floor_x = matched['log_af'].min() - 1.2                             # left \"AF = 0\" band\n",
    "nomatch['log_af'] = floor_x + np.random.default_rng(0).uniform(-0.35, 0.35, len(nomatch))\n",
    "\n",
    "r_val, p_val = sp.stats.pearsonr(matched['log_af'], matched['mean_RAAS'])   # over matched only\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 4))\n",
    "for d in (nomatch, matched):\n",
    "    g, k = d[~d['retained']], d[d['retained']]\n",
    "    ax.scatter(g['log_af'], g['mean_RAAS'], c=GRAY_PT, s=18, linewidths=0, zorder=2)\n",
    "    ax.scatter(k['log_af'], k['mean_RAAS'], c=AF_COLOR, s=18, linewidths=0, zorder=3)\n",
    "ax.axvline(floor_x + 0.6, color='gray', ls=':', lw=0.8)             # separates the no-variant band\n",
    "ax.annotate('no gnomAD\\nvariant (AF=0)', (floor_x, ax.get_ylim()[0]), ha='center', va='bottom',\n",
    "            fontsize=8, color='0.4')\n",
    "ax.set_xlabel(r'$\\log_{10}$(gnomAD allele frequency)', fontsize=13)\n",
    "ax.set_ylabel(r'$\\log_{10}$(RAAS)', fontsize=13)\n",
    "ax.tick_params(axis='both', labelsize=12)\n",
    "ax.text(0.5, 1.02, rf'matched $n={len(matched)}$,  all $n={len(per)}$,  $r={r_val:.3f}$,  $p={p_val:.1e}$',\n",
    "        transform=ax.transAxes, ha='center', va='bottom', fontsize=10)\n",
    "ax.legend(handles=[Line2D([], [], marker='o', ls='', c=AF_COLOR, label='retained (AF-filtered)'),\n",
    "                   Line2D([], [], marker='o', ls='', c=GRAY_PT, label=f'removed: common variant (AF>={AF_THRESHOLD:g})')],\n",
    "          loc='lower right', frameon=True, facecolor='white', edgecolor='0.7', fontsize=8)\n",
    "despine(); plt.tight_layout()\n",
    "plt.savefig(PLOT_DIR + 'QC_SAAP_RAAS_vs_gnomAD_AF_scatter.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 160,
   "id": "gnomadafclassscatter",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 550x440 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Scatter 2 — same axes, restricted to variant-matched SAAPs, colored by allele-frequency class:\n",
    "# pink = common variant (AF >= AF_COMMON), gray = rare (AF < AF_COMMON). Works on the current data\n",
    "# (all matched SAAPs already carry an allele frequency).\n",
    "AF_COMMON = 1e-3   # common-vs-rare allele-frequency cutoff (0.1%)\n",
    "GRAY_PT, PINK_PT = '#999999', '#C41E3A'\n",
    "\n",
    "raas_per_saap = (SAAP_quant_df.replace([np.inf, -np.inf], np.nan)\n",
    "                 .groupby('MTP_seq', as_index=False)['Reporter_RAAS'].mean()\n",
    "                 .rename(columns={'Reporter_RAAS': 'mean_RAAS'}))\n",
    "m = (gnomad_annotated.loc[gnomad_annotated['gnomad_af'] > 0, ['MTP_seq', 'gnomad_af']]\n",
    "     .drop_duplicates('MTP_seq')\n",
    "     .merge(raas_per_saap, on='MTP_seq', how='inner')\n",
    "     .dropna(subset=['gnomad_af', 'mean_RAAS']))\n",
    "m['log_af'] = np.log10(m['gnomad_af'])\n",
    "m['common'] = m['gnomad_af'] >= AF_COMMON\n",
    "\n",
    "x, y = m['log_af'].to_numpy(), m['mean_RAAS'].to_numpy()\n",
    "r_val, p_val = sp.stats.pearsonr(x, y); n_val = len(x)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5, 4))\n",
    "rare, common = m[~m['common']], m[m['common']]\n",
    "ax.scatter(rare['log_af'], rare['mean_RAAS'], c=GRAY_PT, s=22, linewidths=0, zorder=2,\n",
    "           label=f'rare (AF < {AF_COMMON:g}, n={len(rare)})')\n",
    "ax.scatter(common['log_af'], common['mean_RAAS'], c=PINK_PT, s=22, linewidths=0, zorder=3,\n",
    "           label=f'common (AF >= {AF_COMMON:g}, n={len(common)})')\n",
    "ax.axvline(np.log10(AF_COMMON), color='gray', ls='--', lw=0.8)\n",
    "ax.set_xlabel(r'$\\log_{10}$(gnomAD allele frequency)', fontsize=13)\n",
    "ax.set_ylabel(r'$\\log_{10}$(RAAS)', fontsize=13)\n",
    "ax.tick_params(axis='both', labelsize=12)\n",
    "ax.text(0.5, 1.02, rf'matched SAAPs,  $n={n_val}$,  $r={r_val:.3f}$,  $p={p_val:.1e}$',\n",
    "        transform=ax.transAxes, ha='center', va='bottom', fontsize=11)\n",
    "ax.legend(loc='upper left', frameon=True, facecolor='white', edgecolor='0.7', fontsize=9)\n",
    "despine(); plt.tight_layout()\n",
    "plt.savefig(PLOT_DIR + 'QC_SAAP_RAAS_vs_gnomAD_AF_scatter_byAFclass.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
