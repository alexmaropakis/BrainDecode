   ],
   "source": [
    "# 4d. Most-changed SAAP per disease — uses the Brain cohort cached in 4a.\n",
    "# One panel per disease (AD/PD/ADPD): SAAP-level CTRL-vs-disease RAAS scatter (each point =\n",
    "# one SAAP's mean log10 RAAS across its replicates, >= min_reps per group). SAAPs flagged\n",
    "# significant in the 4a heatmap (sig_stats, same rule) are colored by substitution (swap) type\n",
    "# (colors match 4b/4c); all others are grey. The single most-changed SAAP (smallest sel_metric —\n",
    "# p or FDR per the USE_FDR toggle) is circled and annotated with that same metric.\n",
    "def plot_top_saap_per_disease(cohort, agg=scatter_agg, min_pts=min_reps):\n",
    "    cohort_df, name, stats, neuro = cohort['df'], cohort['name'], cohort['stats'], cohort['neuro']\n",
    "    sig_all = cohort['sig_stats']\n",
    "    swap_colors = swap_palette(cohort['df']['aa_sub'].unique())          # complete & consistent palette\n",
    "    if stats.empty:\n",
    "        print(f'[{name}] no SAAP stats.'); return\n",
    "    diseases = [d for d in neuro if d in stats['comparison'].unique()]   # canonical disease order\n",
    "    per = (cohort_df.groupby(SAAP_KEYS + ['Disease'], observed=True)['log10_RAAS']\n",
    "           .agg(['mean', 'median', 'size']).reset_index())\n",
    "    val = per.pivot_table(index=SAAP_KEYS, columns='Disease', values=agg)\n",
    "    cnt = per.pivot_table(index=SAAP_KEYS, columns='Disease', values='size')\n",
    "    fig, axes = plt.subplots(1, len(diseases), figsize=(4 * len(diseases), 4), sharex=True, sharey=True)\n",
    "    axes = np.atleast_1d(axes)\n",
    "    for ax, d in zip(axes, diseases):\n",
    "        if ctrl_label not in val.columns or d not in val.columns:\n",
    "            continue\n",
    "        keep = (cnt[ctrl_label] >= min_pts) & (cnt[d] >= min_pts)\n",
    "        sub = val.loc[keep, [ctrl_label, d]].dropna()\n",
    "        sig_keys = {tuple(k) for k in sig_all.loc[sig_all['comparison'] == d, SAAP_KEYS].values}\n",
    "        is_sig = [k in sig_keys for k in sub.index]\n",
    "        cols = [swap_colors.get(k[2], COLOR_NS) if s else COLOR_NS for k, s in zip(sub.index, is_sig)]\n",
    "        ax.scatter(sub[ctrl_label], sub[d], s=POINT_SIZE, alpha=ALPHA, c=cols, edgecolor=EDGE_COLOR)\n",
    "        if len(sub):\n",
    "            lo, hi = float(sub.values.min()), float(sub.values.max())\n",
    "            ax.plot([lo, hi], [lo, hi], '--', color='red', lw=LINE_W)\n",
    "        top = stats[stats['comparison'] == d].dropna(subset=[sel_metric])\n",
    "        if not top.empty:\n",
    "            top = top.loc[top[sel_metric].idxmin()]\n",
    "            key = (top['MTP_seq'], top['BP_seq'], top['aa_sub'])\n",
    "            if key in val.index:\n",
    "                tx, ty = val.loc[key, ctrl_label], val.loc[key, d]\n",
    "                ax.scatter([tx], [ty], s=POINT_SIZE * 4, facecolor='none', edgecolor='black', linewidth=1.5, zorder=5)\n",
    "                ax.annotate(f\"{top['aa_sub'].replace(' to ', '→')}\\n{sig_metric_label} = {fmt_sci(top[sel_metric])}\",\n",
    "                            xy=(tx, ty), xytext=(6, 6), textcoords='offset points', fontsize=ANNOT_SIZE,\n",
    "                            arrowprops=dict(arrowstyle='-', lw=0.5, color='gray'))\n",
    "        ax.set_title(f'{d} vs CTRL', fontsize=TITLE_SIZE)\n",
    "        ax.set_xlabel(r'log$_{10}$[RAAS$_{CTRL}$]', fontsize=LABEL_SIZE)\n",
    "        ax.spines['left'].set_visible(True); ax.spines['bottom'].set_visible(True)\n",
    "        ax.tick_params(left=True, bottom=True, length=3, labelsize=TICK_SIZE)\n",
    "    axes[0].set_ylabel(r'log$_{10}$[RAAS$_{disease}$]', fontsize=LABEL_SIZE)\n",
    "    plt.tight_layout()\n",
    "    fig.savefig(f'{PLOT_DIR}SAAP_top_changed_per_disease_{name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_top_saap_per_disease(COHORTS['Brain'])\n"
   ]
  },
