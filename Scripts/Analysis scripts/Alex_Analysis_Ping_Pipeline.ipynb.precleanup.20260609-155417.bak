   "source": [
    "## gnomAD filtering and IDs "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 155,
   "id": "c60c869f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Detected SAAPs: 898 | mapped to source protein: 800 | matched a known gnomAD variant: 275\n"
     ]
    }
   ],
   "source": [
    "# read in gnomAD data for annotation of population allele frequencies in downstream analyses\n",
    "# The BLAST-kept SAAPs are checked against gnomAD: polymorphism_flag == True means the apparent\n",
    "# substitution matches a known germline variant; gnomad_af is its population allele frequency.\n",
    "# (QC plots are drawn further down, after the annotated table + AF-threshold filter are built.)\n",
    "GNOMAD_DIR = CODE_DIR + 'gnomAD/'\n",
    "gnomad_annotated = pd.read_csv(GNOMAD_DIR + 'June26_human_gnomad_annotated.csv').rename(columns=blast_key)\n",
    "\n",
    "n_candidate    = len(blast_unfiltered)\n",
    "n_blast_keep   = int((blast_unfiltered['status'] == 'keep').sum())\n",
    "n_polymorphism = int(gnomad_annotated['polymorphism_flag'].sum())\n",
    "print(f'Detected SAAPs: {n_candidate} | mapped to source protein: {n_blast_keep} | '\n",
    "      f'matched a known gnomAD variant: {n_polymorphism}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 156,
   "id": "gnomadfiltdf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Annotated quant table: 6,012 rows -> /Users/alexmaropakis/Projects/BrainDecode/Dependencies/Analysis_Outputs/Ping_2018/SAAP_quant_df_BLASTp_gnomAD_annotated.xlsx\n",
      "     trypsin  immunoglobulin  source_protein_found  gnomad_polymorphism\n",
      "NO      5976            5980                   689                 4448\n",
      "YES       36              32                  5323                 1564\n",
      "SAAP_quant_df_gnomAD (BLAST-kept & non-polymorphism): 3,759 rows\n"
     ]
    }
   ],
   "source": [
    "# Append BLASTp + gnomAD outputs to the SAAP quant table (NO row filtering) and export to xlsx.\n",
    "# Every SAAP row is kept; QC outcomes are recorded as aligned columns/flags so downstream code can\n",
    "# filter as needed. YES/NO flags: source_protein_found, matches_reference, no_source_protein,\n",
    "# trypsin, immunoglobulin (from BLASTp status); gnomad_polymorphism (from gnomAD). Raw fields:\n",
    "# gene / accession / protein_pos / ambiguous (BLASTp) and gnomad_variant / gnomad_af / gnomad_note.\n",
    "key = ['Dataset', 'MTP_seq', 'BP_seq']\n",
    "blast_cols  = key + ['status', 'gene', 'accession', 'protein_pos', 'ambiguous']\n",
    "gnomad_cols = key + ['gnomad_variant', 'gnomad_af', 'gnomad_note', 'polymorphism_flag',\n",
    "                     'aa_pos_match', 'aa_change_in_gene', '_any']\n",
    "annot = (blast_unfiltered[blast_cols].drop_duplicates(key)\n",
    "         .merge(gnomad_annotated[gnomad_cols].drop_duplicates(key), on=key, how='left')\n",
    "         .rename(columns={'status': 'blast_status', '_any': 'gnomad_variant_in_gene'}))\n",
    "\n",
    "yn = lambda mask: np.where(mask.fillna(False).astype(bool), 'YES', 'NO')\n",
    "annot['source_protein_found'] = yn(annot['blast_status'] == 'keep')\n",
    "annot['matches_reference']    = yn(annot['blast_status'] == 'drop_reference')\n",
    "annot['no_source_protein']    = yn(annot['blast_status'] == 'drop_no_parent')\n",
    "annot['trypsin']              = yn(annot['blast_status'] == 'drop_trypsin')\n",
    "annot['immunoglobulin']       = yn(annot['blast_status'] == 'drop_ig')\n",
    "annot['gnomad_polymorphism']  = yn(annot['polymorphism_flag'] == True)\n",
    "annot['variant_in_gene']      = yn(annot['gnomad_variant_in_gene'] == True)   # any gnomAD variant in the gene (not necessarily at the substituted site)\n",
    "\n",
    "# left-merge onto the quant table; idempotent (drop any previously-added annotation columns first)\n",
    "new_cols = [c for c in annot.columns if c not in key]\n",
    "SAAP_quant_df_annotated = (SAAP_quant_df.drop(columns=[c for c in new_cols if c in SAAP_quant_df.columns])\n",
    "                           .merge(annot, on=key, how='left'))\n",
    "\n",
    "out_path = OUTDIR + 'SAAP_quant_df_BLASTp_gnomAD_annotated.xlsx'\n",
    "SAAP_quant_df_annotated.to_excel(out_path, index=False)\n",
    "print(f'Annotated quant table: {len(SAAP_quant_df_annotated):,} rows -> {out_path}')\n",
    "print(SAAP_quant_df_annotated[['trypsin', 'immunoglobulin', 'source_protein_found', 'gnomad_polymorphism']]\n",
    "      .apply(pd.Series.value_counts).fillna(0).astype(int))\n",
    "\n",
    "# convenience: BLAST-kept & non-polymorphism subset, kept SEPARATE (not exported, not used by default)\n",
    "SAAP_quant_df_gnomAD = SAAP_quant_df_annotated[\n",
    "    (SAAP_quant_df_annotated['source_protein_found'] == 'YES') &\n",
    "    (SAAP_quant_df_annotated['gnomad_polymorphism'] == 'NO')].copy()\n",
    "print(f'SAAP_quant_df_gnomAD (BLAST-kept & non-polymorphism): {len(SAAP_quant_df_gnomAD):,} rows')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 157,
   "id": "gnomadafthreshfilt",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "AF threshold = 0.01  (drop SAAPs matching a gnomAD variant with AF >= 0.01)\n",
      "  rows:         6,012 -> 4,867\n",
      "  unique SAAPs: 476 -> 412  (64 dropped as common variants)\n"
     ]
    }
   ],
   "source": [
    "# Custom gnomAD allele-frequency filter — set the threshold here to build YOUR OWN filtered df,\n",
    "# separate from the pre-filtered csv (which removes every variant match regardless of AF).\n",
    "# gnomAD AF conventions: COMMON >= 1% (0.01); LOW-FREQUENCY 0.1-1% (0.001-0.01); RARE < 0.1% (0.001).\n",
    "# Disease/biology analyses typically drop COMMON germline variants (likely benign polymorphisms)\n",
    "# and keep rare ones. Here a SAAP is dropped if its substitution matches a gnomAD variant with\n",
    "# AF >= AF_THRESHOLD; SAAPs with no matched variant, or a below-threshold (rarer) variant, are kept.\n",
    "AF_THRESHOLD = 0.01   # <-- set your allele-frequency cutoff (0.01 = gnomAD common-variant definition)\n",
    "\n",
    "is_common_variant = SAAP_quant_df_annotated['gnomad_af'] >= AF_THRESHOLD   # NaN (no variant) -> False -> kept\n",
    "SAAP_quant_df_AFfiltered = SAAP_quant_df_annotated[~is_common_variant].copy()\n",
    "\n",
    "n_drop = SAAP_quant_df_annotated.loc[is_common_variant, 'MTP_seq'].nunique()\n",
    "print(f'AF threshold = {AF_THRESHOLD:g}  (drop SAAPs matching a gnomAD variant with AF >= {AF_THRESHOLD:g})')\n",
    "print(f'  rows:         {len(SAAP_quant_df_annotated):,} -> {len(SAAP_quant_df_AFfiltered):,}')\n",
    "print(f'  unique SAAPs: {SAAP_quant_df_annotated[\"MTP_seq\"].nunique():,} -> '\n",
    "      f'{SAAP_quant_df_AFfiltered[\"MTP_seq\"].nunique():,}  ({n_drop:,} dropped as common variants)')\n",
    "\n",
    "# optional export of the custom-filtered table\n",
    "SAAP_quant_df_AFfiltered.to_excel(OUTDIR + f'SAAP_quant_df_AFfiltered_{AF_THRESHOLD:g}.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 158,
   "id": "gnomadqcplots",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 506x440 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
