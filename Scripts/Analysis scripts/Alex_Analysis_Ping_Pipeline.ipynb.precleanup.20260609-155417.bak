   "id": "refprot_plot_diseasesig",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1210x605 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Rank plot: disease-significant SAAP proteins + classic neurodegeneration genes ──\n",
    "# Two highlight groups on the protein-RAAS ranking:\n",
    "#   teal    = protein has >=1 SAAP significantly changed in a disease vs CTRL (section-4 sig_stats,\n",
    "#             i.e. sel_metric<=sel_thresh & |log2FC|>=min_abs_log2fc), mapped to its source-protein gene\n",
    "#   magenta = classic neurodegeneration gene (NEURODEGEN_GENES from the neurodegeneration plot)\n",
    "#   teal fill + magenta ring = both.\n",
    "sig_saaps = set()\n",
    "for _c in COHORTS.values():\n",
    "    _s = _c.get('sig_stats')\n",
    "    if _s is not None and not _s.empty:\n",
    "        sig_saaps |= set(_s['MTP_seq'])\n",
    "\n",
    "ref_prot_df['disease_sig'] = ref_prot_df['SAAPs'].map(lambda ss: bool(set(ss) & sig_saaps))\n",
    "ref_prot_df['neurodegen']  = ref_prot_df['Genes'].map(lambda gs: bool(set(_gene_tokens(gs)) & NEURODEGEN_GENES))\n",
    "\n",
    "sns.set_style('ticks')\n",
    "fig, ax = plt.subplots(figsize=(11, 5.5))\n",
    "ax.scatter(ref_prot_df['Rank'], ref_prot_df['Median RAAS'], color='#cccccc', s=42, linewidth=0, zorder=1)\n",
    "both = ref_prot_df[ref_prot_df['disease_sig'] & ref_prot_df['neurodegen']]\n",
    "ds_  = ref_prot_df[ref_prot_df['disease_sig'] & ~ref_prot_df['neurodegen']]\n",
    "ndg  = ref_prot_df[ref_prot_df['neurodegen'] & ~ref_prot_df['disease_sig']]\n",
    "ax.scatter(ds_['Rank'], ds_['Median RAAS'], color=COLOR_DOWN, s=58, linewidth=0, zorder=3,\n",
    "           label=f'disease-significant SAAP (n={int(ref_prot_df[\"disease_sig\"].sum())})')\n",
    "ax.scatter(ndg['Rank'], ndg['Median RAAS'], color=COLOR_UP, s=58, linewidth=0, zorder=3,\n",
    "           label=f'neurodegeneration gene (n={int(ref_prot_df[\"neurodegen\"].sum())})')\n",
    "ax.scatter(both['Rank'], both['Median RAAS'], color=COLOR_DOWN, s=70, linewidth=1.4, edgecolor=COLOR_UP, zorder=4, label='both')\n",
    "ax.set_xlabel('Protein rank', fontsize=15); ax.set_ylabel(r'Median log$_{10}$(RAAS)', fontsize=15)\n",
    "ax.tick_params('both', labelsize=13); ax.legend(fontsize=9, bbox_to_anchor=(1.01, 1), loc='upper left')\n",
    "hl = ref_prot_df[ref_prot_df['disease_sig'] | ref_prot_df['neurodegen']].copy()\n",
    "hl['label'] = hl['Genes'].map(lambda g: g[0] if g else '')\n",
    "hl['color'] = np.where(hl['neurodegen'] & ~hl['disease_sig'], COLOR_UP, COLOR_DOWN)\n",
    "hl = hl.sort_values('Median RAAS', ascending=False).drop_duplicates('label')\n",
    "label_ranked(ax, hl, fontsize=7)\n",
    "despine()\n",
    "plt.savefig(PLOT_DIR + 'Protein_RAAS_rank_diseaseSig_neurodegen.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 220,
   "id": "refprot_dotplots",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 583x618.2 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ── Matrix bubble plot: top high-RAAS GO:BP terms x disease state (per-SAAP medians) ──\n",
    "# Tested on PER-SAAP MEDIANS (each SAAP = one value; no per-observation pseudo-replication). Rows =\n",
    "# GO:BP terms ranked by per-SAAP median RAAS, restricted to terms with >= MIN_SAAP unique SAAPs.\n",
    "# COLOR = median per-SAAP log10(RAAS) in the cell; SIZE = -log10(p) (two-sided Welch t-test of the\n",
    "# cell's per-SAAP medians vs the disease column's). Top = # SAAP-medians/disease; right = # SAAPs/term.\n",
    "# NOTE: per-SAAP, the GO high-RAAS signal is far weaker than per-observation (~1 term at FDR<0.01),\n",
    "# so rows are ranked by effect with a SAAP-count floor (not an FDR cut).\n",
    "import re, collections\n",
    "COL_VAR, TOP_TERMS, MIN_SAAP = 'Sample Type', 13, 5\n",
    "col_order = [c for c in ['CTRL', 'AD', 'PD', 'ADPD'] if c in SAAP_quant_df[COL_VAR].unique()]\n",
    "\n",
    "gene_by_saap = blast_filtered.dropna(subset=['accession']).drop_duplicates('MTP_seq').set_index('MTP_seq')['gene']\n",
    "o = (SAAP_quant_df.replace([np.inf, -np.inf], np.nan).dropna(subset=['Reporter_RAAS'])[['MTP_seq', 'Reporter_RAAS', COL_VAR]]).copy()\n",
    "o['gene'] = o['MTP_seq'].map(gene_by_saap); o = o.dropna(subset=['gene'])\n",
    "o['terms'] = o['gene'].map(lambda g: {t for tok in re.split(r'[;/,]', str(g)) for t in GENE2GO.get(tok.strip().upper(), [])})\n",
    "mtp_terms = o.drop_duplicates('MTP_seq').set_index('MTP_seq')['terms']\n",
    "\n",
    "saap_all = o.groupby('MTP_seq', as_index=False)['Reporter_RAAS'].median(); saap_all['terms'] = saap_all['MTP_seq'].map(mtp_terms)\n",
    "tvals = collections.defaultdict(list)\n",
    "for r, ts in zip(saap_all['Reporter_RAAS'], saap_all['terms']):\n",
    "    for t in ts: tvals[t].append(r)\n",
    "terms = [t for _, t in sorted(((np.median(v), t) for t, v in tvals.items() if len(v) >= MIN_SAAP), reverse=True)[:TOP_TERMS]]\n",
    "tset = set(terms)\n",
    "\n",
    "sm = o.groupby(['MTP_seq', COL_VAR], as_index=False)['Reporter_RAAS'].median(); sm['terms'] = sm['MTP_seq'].map(mtp_terms)\n",
    "cell, coltot, term_saaps = collections.defaultdict(list), collections.defaultdict(list), collections.defaultdict(set)\n",
    "for mtp, r, d, ts in zip(sm['MTP_seq'], sm['Reporter_RAAS'], sm[COL_VAR], sm['terms']):\n",
    "    if d in col_order: coltot[d].append(r)\n",
    "    for t in (ts & tset):\n",
    "        if d in col_order: cell[(t, d)].append(r); term_saaps[t].add(mtp)\n",
    "\n",
    "cmeds = [np.median(v) for v in cell.values() if len(v) >= 3]\n",
    "vmin, vmax = np.percentile(cmeds, 5), np.percentile(cmeds, 95)\n",
    "fig, ax = plt.subplots(figsize=(0.5 * len(col_order) + 3.3, 0.34 * len(terms) + 1.2)); cmap = plt.get_cmap('magma')\n",
    "for yi, t in enumerate(terms):\n",
    "    for xi, d in enumerate(col_order):\n",
    "        v = cell.get((t, d), [])\n",
    "        if len(v) < 3: continue\n",
    "        _, pv = sp.stats.ttest_ind(v, coltot[d], equal_var=False)\n",
    "        ax.scatter(xi, yi, s=8 + min(-np.log10(max(pv, 1e-300)), 8) * 12,\n",
    "                   c=[np.median(v)], cmap=cmap, vmin=vmin, vmax=vmax, edgecolor='none', zorder=3)\n",
    "ax.set_xticks(range(len(col_order))); ax.set_xticklabels(col_order, fontsize=8)\n",
    "ax.set_yticks(range(len(terms))); ax.set_yticklabels([t.split(' (GO:')[0][:30] for t in terms], fontsize=7.5); ax.invert_yaxis()\n",
    "for xi, d in enumerate(col_order): ax.annotate(f'{len(coltot[d])}', (xi, -0.7), ha='center', fontsize=6.5, annotation_clip=False)\n",
    "for yi, t in enumerate(terms): ax.annotate(f'{len(term_saaps[t])}', (len(col_order) - 0.32, yi), ha='left', va='center', fontsize=6.5, annotation_clip=False)\n",
    "cb = fig.colorbar(plt.cm.ScalarMappable(cmap=cmap, norm=plt.Normalize(vmin, vmax)), ax=ax, shrink=0.4, pad=0.18, aspect=12)\n",
    "cb.set_label(r'median log$_{10}$[RAAS]', fontsize=7); cb.ax.tick_params(labelsize=6)\n",
    "for lp in [2, 4, 8]: ax.scatter([], [], s=8 + lp * 12, c='gray', edgecolor='none', label=f'{lp}')\n",
    "ax.legend(title=r'$-\\log_{10}$[p]', fontsize=6, title_fontsize=6, labelspacing=0.8, bbox_to_anchor=(1.14, 0.0), loc='lower left', frameon=False)\n",
    "ax.set_xlim(-0.5, len(col_order) - 0.3); ax.set_ylim(len(terms) - 0.5, -1.2); ax.tick_params(length=0)\n",
    "for s in ax.spines.values(): s.set_visible(False)\n",
    "ax.set_title('Top high-RAAS GO:BP terms (per-SAAP median) by disease', fontsize=8, pad=10)\n",
    "plt.savefig(PLOT_DIR + 'GO_term_RAAS_bubble_matrix.pdf', bbox_inches='tight'); plt.show()"
   ]
  }
 ],
