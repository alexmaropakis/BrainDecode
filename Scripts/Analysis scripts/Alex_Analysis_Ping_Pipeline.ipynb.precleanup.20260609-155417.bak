   ],
   "source": [
    "# 4f. Disease-vs-CTRL RAAS fold-change distributions — Brain cohort.\n",
    "# Per-replicate log2(RAAS / CTRL mean) per SAAP (normalize_logfc); one bihist panel per\n",
    "# disease in canonical disease order. N = number of fold-change values per disease.\n",
    "def plot_logfc_distributions(cohort):\n",
    "    cohort_df, name, neuro = cohort['df'], cohort['name'], cohort['neuro']\n",
    "    norm = normalize_logfc(cohort_df)\n",
    "    diseases = [d for d in neuro if d in norm['Disease'].unique()]      # canonical disease order\n",
    "    data = {d: norm.loc[norm['Disease'] == d, 'log2FC'].replace([np.inf, -np.inf], np.nan).dropna().values\n",
    "            for d in diseases}\n",
    "    fig, axes = plt.subplots(1, len(diseases), figsize=(1.6 * len(diseases), 3), sharey=True)\n",
    "    axes = np.atleast_1d(axes)\n",
    "    for ax in axes:\n",
    "        ax.spines['right'].set_visible(False); ax.spines['top'].set_visible(False)\n",
    "        ax.tick_params('x', bottom=False, labelbottom=False)\n",
    "        if ax is not axes[0]:\n",
    "            ax.spines['left'].set_visible(False); ax.tick_params(left=False)\n",
    "    for ax, d in zip(axes, diseases):\n",
    "        vals = data[d]\n",
    "        ax.set_xlabel(d, fontsize=14)\n",
    "        bihist(vals, vals, nbins=40, h=ax, color=DISEASE_COLORS.get(d))\n",
    "        ax.annotate(f'{len(vals):,}', (0.2, 1.03), xycoords='axes fraction', fontsize=12)\n",
    "        ax.axhline(np.median(vals) if len(vals) else 0, ls='--', color='red', lw=1.0)\n",
    "    axes[0].annotate('N=', (-0.25, 1.03), xycoords='axes fraction', fontsize=12)\n",
    "    axes[0].set_ylabel(r'log$_2$(RAAS / CTRL)', fontsize=15); axes[0].tick_params('y', labelsize=13)\n",
    "    fig.suptitle(f'{name}: per-SAAP RAAS fold change vs CTRL', fontsize=TITLE_SIZE)\n",
    "    plt.tight_layout()\n",
    "    fig.savefig(f'{PLOT_DIR}SAAP_log2FC_vs_CTRL_distributions_{name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_logfc_distributions(COHORTS['Brain'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 208,
   "id": "newsigtissue4g",
