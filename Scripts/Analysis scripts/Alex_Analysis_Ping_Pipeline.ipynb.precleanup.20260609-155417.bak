   "source": [
    "# Tissue-specific log2 fold change relative to tissue-specific CTRL baselines,\n",
    "# split into separate ACG and FC heatmaps.\n",
    "\n",
    "sub_df = add_replicate_cols(SAAP_quant_df_grouped)\n",
    "sub_df['log10_RAAS'] = sub_df[raas_col]\n",
    "sub_df = sub_df.replace([np.inf, -np.inf], np.nan).dropna(subset=['log10_RAAS'])\n",
    "\n",
    "# Split into ACG and FC cohorts\n",
    "acg_df = sub_df[sub_df['Dataset'] == 'acg'].copy()\n",
    "fc_df = sub_df[sub_df['Dataset'] == 'fc'].copy()\n",
    "\n",
    "plot_cohort_heatmap(acg_df, 'ACG')\n",
    "plot_cohort_heatmap(fc_df, 'FC')"
   ]
  },
