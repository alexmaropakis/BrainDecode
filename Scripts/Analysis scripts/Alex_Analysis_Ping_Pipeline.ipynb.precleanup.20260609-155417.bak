   ],
   "source": [
    "# Plot ANOVA statistics for tissue dependent RAAS changes per AAS type\n",
    "anova_df = pd.read_csv(OUTDIR+'ANOVAwTukey_RAASBetweenTissuesperAASType_REPLICATE_LEVEL.tsv',sep='\\t')\n",
    "plot_df=anova_df.copy()\n",
    "plot_df=plot_df.loc[plot_df['p']<0.05]\n",
    "plot_df=plot_df.loc[plot_df['n_sig_pairs']>0]\n",
    "plot_df=plot_df.sort_values('F',ascending=False)\n",
    "fig,ax=plt.subplots(figsize=(7,7))\n",
    "\n",
    "sns.barplot(data=plot_df,\n",
    "            x='AAS_type',\n",
    "            y='F',\n",
    "            color='#aaaaaa',\n",
    "            ax=ax)\n",
    "\n",
    "ax.tick_params('both',labelsize=12)\n",
    "plt.xticks(rotation=90)\n",
    "plt.ylabel('ANOVA F statistic',fontsize=14)\n",
    "plt.yscale('log')\n",
    "plt.xlabel('AA substitution',fontsize=14)\n",
    "plt.title('Tissue-dependent RAAS effects across substitution types\\n(one-way ANOVA per AAS, replicate level; shown: p<0.05 & ≥1 significant Tukey pair)',fontsize=11)\n",
    "\n",
    "despine()\n",
    "plt.savefig(PLOT_DIR+'ANOVA_F_ranked.pdf', bbox_inches='tight')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 190,
   "id": "7d067d5c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 495x495 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Factors of RAAS variation — multi-factor ANOVA (adapted from the original Type-III model).\n",
    "# Single linear model Reporter_RAAS ~ C(Tissue) + C(AAS) + C(Disease), Type-III sums of squares;\n",
    "# one bar per factor (higher F = more RAAS variance explained). P values from the F-tests.\n",
    "anova_src = add_replicate_cols(SAAP_quant_df_grouped)\n",
    "anova_src = anova_src.replace([np.inf, -np.inf], np.nan).dropna(subset=[raas_col])\n",
    "anova_src = filter_complete_saaps(anova_src, within=['Tissue'])\n",
    "n_obs = len(anova_src)\n",
    "\n",
    "model = ols(f'{raas_col} ~ C(Tissue) + C(aa_sub) + C(Disease)', data=anova_src).fit()\n",
    "aov = sm.stats.anova_lm(model, typ=3).reset_index().rename(columns={'index': 'term'})\n",
    "factor_map = {'C(Tissue)': 'Tissue', 'C(aa_sub)': 'AAS', 'C(Disease)': 'Disease'}\n",
    "aov = aov[aov['term'].isin(factor_map)].copy()\n",
    "aov['Factor'] = aov['term'].map(factor_map)\n",
    "aov = aov.sort_values('F')                       # strongest factor on the right\n",
    "\n",
    "greys = ['#d9d9d9', '#969696', '#525252']\n",
    "fig, ax = plt.subplots(figsize=(4.5, 4.5))\n",
    "for i, (_, r) in enumerate(aov.iterrows()):\n",
    "    ax.bar(i, r['F'], color=greys[i % len(greys)], width=0.7)\n",
    "handles = [mpatches.Patch(color=greys[i % len(greys)], label=f\"{r['Factor']}: P = {fmt_sci(r['PR(>F)'])}\")\n",
    "           for i, (_, r) in enumerate(aov.iterrows())]\n",
    "ax.legend(handles=handles, frameon=False, fontsize=LEGEND_SIZE, loc='upper left')\n",
    "ax.set_xticks(range(len(aov))); ax.set_xticklabels(aov['Factor'], fontsize=12)\n",
    "ax.set_ylabel('ANOVA $F$-statistic', fontsize=13)\n",
    "ax.set_title(f'Factors of RAAS variation (Type-III ANOVA, n = {n_obs:,})', fontsize=12)\n",
    "ax.spines['left'].set_visible(True); ax.spines['bottom'].set_visible(True)\n",
    "ax.tick_params(left=True, bottom=True, length=3, labelsize=10)\n",
    "plt.tight_layout()\n",
    "fig.savefig(f'{PLOT_DIR}ANOVA_F_by_factor.pdf', bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
