   ],
   "source": [
    "# Tissue-specific log2FC vs tissue CTRL + one-way ANOVA of RAAS across disease groups\n",
    "# per (tissue, aa_sub), at two aggregation levels: SAAP-level (per-SAAP medians,\n",
    "# >= min_saap_per_aas SAAPs) and replicate-level (no SAAP collapsing). BH-FDR across pairs.\n",
    "for level, collapse, tag in [('SAAP-level', True, ''), ('replicate-level', False, '_REPLICATE_LEVEL')]:\n",
    "    norm_df, anova_df, sig_pairs = tissue_ctrl_log2fc_anova(SAAP_quant_df_grouped, collapse_saap=collapse)\n",
    "    anova_out_df = (anova_df.merge(sig_pairs[['Tissue', 'aa_sub', 'max_abs_log2FC']],\n",
    "                                   on=['Tissue', 'aa_sub'], how='left')\n",
    "                    .sort_values(['FDR', 'p_value']))\n",
    "    anova_out_df.to_csv(f'{PLOT_DIR}ALL_substitution_ANOVA_results{tag}.csv', index=False)\n",
    "    if collapse:   # significant (tissue, aa_sub) pairs (SAAP-level only)\n",
    "        (sig_pairs[['Tissue', 'aa_sub', 'max_abs_log2FC', 'F_statistic', 'p_value', 'FDR']]\n",
    "         .sort_values(['FDR', 'max_abs_log2FC'], ascending=[True, False])\n",
    "         .to_csv(f'{PLOT_DIR}top_substitution_log2FC_tissue_specific_CTRL_ANOVA_results.csv', index=False))\n",
    "    print(f'=== {level} tissue ANOVA ===')\n",
    "    print(anova_out_df)\n"
   ]
  },
