   "source": [
    "## plot_raas_tissue_disease_heatmap\n",
    "# Median-RAAS heatmap (substitution x tissue+disease), columns always ordered ACG-then-FC.\n",
    "# Backs the ACG/FC \"top-15 AAS\" figures and the pooled \"tissue-specific top AAS\" figures.\n",
    "def plot_raas_tissue_disease_heatmap(sub_df, title, fname, *, figsize=(20, 10),\n",
    "                                     top_n=15, per_tissue=False):\n",
    "    sub_df = add_replicate_cols(sub_df)\n",
    "    sub_df = filter_complete_saaps(sub_df, within=['Tissue'])          # complete SAAPs per tissue\n",
    "    tissue_order = ([t for t in TISSUE_ORDER if t in sub_df['Tissue'].unique()]\n",
    "                    or sorted(sub_df['Tissue'].dropna().unique()))\n",
    "\n",
    "    if per_tissue:   # union of each tissue's most frequent substitutions\n",
    "        top_subs = []\n",
    "        for tissue in tissue_order:\n",
    "            top_subs += (sub_df[sub_df['Tissue'] == tissue][SAAP_KEYS].drop_duplicates()\n",
    "                         ['aa_sub'].value_counts().head(top_n).index.tolist())\n",
    "        top_subs = list(dict.fromkeys(top_subs))\n",
    "    else:            # globally most frequent substitutions\n",
    "        top_subs = (sub_df[['Tissue'] + SAAP_KEYS].drop_duplicates()\n",
    "                    ['aa_sub'].value_counts().head(top_n).index)\n",
    "\n",
    "    plot_df = sub_df[sub_df['aa_sub'].isin(top_subs)].copy()\n",
    "    sub_order = (plot_df['aa_sub'].value_counts().reindex(top_subs).dropna().index\n",
    "                 if per_tissue else top_subs)\n",
    "    plot_df['aa_sub'] = pd.Categorical(plot_df['aa_sub'], categories=sub_order, ordered=True)\n",
    "    plot_df['Tissue'] = pd.Categorical(plot_df['Tissue'], categories=tissue_order, ordered=True)\n",
    "    plot_df['Disease'] = pd.Categorical(plot_df['Disease'], categories=disease_order, ordered=True)\n",
    "\n",
    "    # median RAAS per unique SAAP within tissue+disease, keep AAS with enough SAAPs,\n",
    "    # then the median of those SAAP medians within each AAS group.\n",
    "    saap_keys = ['Tissue', 'Disease'] + SAAP_KEYS\n",
    "    saap_median_df = (plot_df.groupby(saap_keys, observed=False)[raas_col]\n",
    "                      .median().reset_index(name='SAAP_median_RAAS'))\n",
    "    aas_counts = (saap_median_df.groupby(['Tissue', 'Disease', 'aa_sub'], observed=False)\n",
    "                  .size().reset_index(name='n_saap'))\n",
    "    valid_aas = aas_counts[aas_counts['n_saap'] >= min_saap_per_aas][['Tissue', 'Disease', 'aa_sub']]\n",
    "    saap_median_df = saap_median_df.merge(valid_aas, on=['Tissue', 'Disease', 'aa_sub'], how='inner')\n",
    "    heatmap_df = (saap_median_df.groupby(['aa_sub', 'Disease', 'Tissue'], observed=False)['SAAP_median_RAAS']\n",
    "                  .median().reset_index(name='Median_RAAS'))\n",
    "    heatmap_df['Tissue_Disease'] = heatmap_df['Tissue'].astype(str) + '_' + heatmap_df['Disease'].astype(str)\n",
    "\n",
    "    # columns always ACG (all diseases) then FC (all diseases)\n",
    "    column_order = order_tissue_disease([f'{t}_{d}' for t in tissue_order for d in disease_order])\n",
    "    heatmap_matrix = (heatmap_df.pivot(index='aa_sub', columns='Tissue_Disease', values='Median_RAAS')\n",
    "                      .reindex(index=sub_order).reindex(columns=column_order))\n",
    "\n",
    "    plt.figure(figsize=figsize)\n",
    "    max_abs = np.nanmax(np.abs(heatmap_matrix.values))   # symmetric scale -> 0 at the yellow center\n",
    "    plt.imshow(heatmap_matrix, aspect='auto', cmap=cmap, vmin=-max_abs, vmax=max_abs)\n",
    "    heatmap_cbar('median RAAS')\n",
    "    for x in np.arange(len(disease_order), len(column_order), len(disease_order)) - 0.5:\n",
    "        plt.axvline(x, color='white', linewidth=3)                    # separate tissue blocks\n",
    "    ax = plt.gca()\n",
    "    for ti, t in enumerate(tissue_order):                             # tissue label above each block\n",
    "        ax.annotate(t.upper(), xy=((ti * len(disease_order) + len(disease_order) / 2) / len(column_order), 1.01),\n",
    "                    xycoords='axes fraction', ha='center', va='bottom', fontsize=26, fontweight='bold')\n",
    "    plt.xticks(np.arange(len(column_order)), [pretty_disease(c) for c in column_order], rotation=90, fontsize=25)\n",
    "    plt.yticks(np.arange(len(heatmap_matrix.index)), heatmap_matrix.index, fontsize=25)\n",
    "    plt.xlabel('Disease', fontsize=30); plt.ylabel('AA substitution', fontsize=30)\n",
    "    plt.title(f'{title}\\n(median of per-SAAP median RAAS; AAS with ≥{min_saap_per_aas} qualifying SAAPs; columns ACG→FC)',\n",
    "              fontsize=22, pad=40)\n",
    "    plt.tight_layout(); plt.tick_params(axis='both', length=5); plt.grid(False); strip_box()\n",
    "    plt.savefig(PLOT_DIR + fname, bbox_inches='tight')\n",
    "    plt.show()\n"
   ]
  },
