   "cell_type": "code",
   "execution_count": 206,
   "id": "newaasvol4e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 528x440 with 1 Axes>"
      ]
