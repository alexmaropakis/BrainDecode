    "fc_samples_list = [fcb1_samples, fcb2_samples, fcb3_samples, fcb4_samples, fcb5_samples]\n",
    "\n",
    "mq_dir_list = [acgb1_mq, acgb2_mq, acgb3_mq, acgb4_mq, acgb5_mq, fcb1_mq, fcb2_mq, fcb3_mq, fcb4_mq, fcb5_mq]\n",
