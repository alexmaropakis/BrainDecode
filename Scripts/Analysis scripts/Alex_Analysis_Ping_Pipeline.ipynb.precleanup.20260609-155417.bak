    "## plot_saap_swap_volcano\n",
    "# Per-SAAP RAAS-vs-CTRL volcano (individual-SAAP level — maximal power), one panel per disease.\n",
    "# ALL testable SAAPs are plotted; those passing the SAME rule as the 4a heatmap\n",
    "# (sel_metric <= sel_thresh & |log2FC| >= min_abs_log2fc) are colored by their substitution\n",
    "# (swap) type, everything else is grey. Swap-type colors match the 4c scatter.\n",
    "def plot_saap_swap_volcano(cohort, label_top=8):\n",
    "    stats, name, neuro = cohort['stats'], cohort['name'], cohort['neuro']\n",
    "    sig_all = cohort['sig_stats']\n",
    "    swap_colors = swap_palette(cohort['df']['aa_sub'].unique())        # complete & consistent palette\n",
    "    if stats.empty:\n",
    "        print(f'[{name}] no testable SAAPs.'); return\n",
    "    cmps = [c for c in neuro if c in stats['comparison'].unique()]\n",
    "    fig, axes = plt.subplots(1, len(cmps), figsize=(len(cmps) * 3.4, 3.8), sharey=False)\n",
    "    axes = np.atleast_1d(axes)\n",
    "    for ax, cmp in zip(axes, cmps):\n",
    "        d = stats[stats['comparison'] == cmp].dropna(subset=[sel_metric, 'mean_log2FC']).copy()\n",
    "        d['y'] = -np.log10(d[sel_metric].clip(lower=1e-300))\n",
    "        sig = (d[sel_metric] <= sel_thresh) & (d['mean_log2FC'].abs() >= min_abs_log2fc)\n",
    "        ax.scatter(d.loc[~sig, 'mean_log2FC'], d.loc[~sig, 'y'], s=POINT_SIZE,        # all non-sig SAAPs\n",
    "                   color=COLOR_NS, alpha=ALPHA, edgecolor=EDGE_COLOR)\n",
    "        ds = d[sig]\n",
    "        ax.scatter(ds['mean_log2FC'], ds['y'], s=POINT_SIZE,                          # sig SAAPs by swap type\n",
    "                   color=[swap_colors.get(a, COLOR_NS) for a in ds['aa_sub']],\n",
    "                   alpha=ALPHA, edgecolor=EDGE_COLOR)\n",
    "        ax.axvline(min_abs_log2fc, color='gray', ls='--', lw=0.7)\n",
    "        ax.axvline(-min_abs_log2fc, color='gray', ls='--', lw=0.7)\n",
    "        ax.axhline(-np.log10(sel_thresh), color='gray', ls='--', lw=0.7)\n",
    "        up = int(((ds['mean_log2FC'] >= min_abs_log2fc)).sum())\n",
    "        down = int(((ds['mean_log2FC'] <= -min_abs_log2fc)).sum())\n",
    "        ax.annotate(f'↑{up}', xy=(0.97, 0.96), xycoords='axes fraction', ha='right', va='top',\n",
    "                    color=COLOR_UP, fontsize=ANNOT_SIZE, fontweight='bold')\n",
    "        ax.annotate(f'↓{down}', xy=(0.03, 0.96), xycoords='axes fraction', ha='left', va='top',\n",
    "                    color=COLOR_DOWN, fontsize=ANNOT_SIZE, fontweight='bold')\n",
    "        for _, r in ds.sort_values('y', ascending=False).head(label_top).iterrows():\n",
    "            ax.annotate(r['aa_sub'].replace(' to ', '→'), xy=(r['mean_log2FC'], r['y']),\n",
    "                        xytext=(5, 2), textcoords='offset points', fontsize=6,\n",
    "                        arrowprops=dict(arrowstyle='-', lw=0.3, color='gray'))\n",
    "        ax.set_title(f'{cmp} vs CTRL', fontsize=LABEL_SIZE)\n",
    "        ax.set_xlabel(r'log$_2$(fold change)', fontsize=LABEL_SIZE)\n",
    "        ax.spines['left'].set_visible(True); ax.spines['bottom'].set_visible(True)\n",
    "        ax.tick_params(left=True, bottom=True, length=3, labelsize=TICK_SIZE)\n",
    "    axes[0].set_ylabel(r'$-\\log_{10}$(%s)' % sig_metric_label, fontsize=LABEL_SIZE)\n",
    "    present = sorted(sig_all['aa_sub'].unique()) if not sig_all.empty else []         # shared swap legend\n",
    "    handles = [Line2D([0], [0], marker='o', ls='', markersize=6, markeredgecolor='none',\n",
    "                      markerfacecolor=swap_colors[a], label=a.replace(' to ', '→')) for a in present]\n",
    "    if handles:\n",
    "        fig.legend(handles=handles, title='substitution', fontsize=LEGEND_SIZE, title_fontsize=LEGEND_SIZE,\n",
    "                   frameon=False, loc='center left', bbox_to_anchor=(1.0, 0.5),\n",
    "                   ncol=1 if len(handles) <= 18 else 2)\n",
    "    fig.suptitle(f'{name}: per-SAAP RAAS vs CTRL — Welch t-test\\n'\n",
    "                 f'(colored = significant: {sig_metric_label} ≤ {sel_thresh} & |log$_2$FC| ≥ {min_abs_log2fc})', fontsize=TITLE_SIZE)\n",
    "    plt.tight_layout()\n",
    "    fig.savefig(f'{PLOT_DIR}SAAP_swap_volcano_{name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 136,
   "id": "fbfc9229",
   "metadata": {},
   "outputs": [],
   "source": [
    "## plot_significant_saap_scatter\n",
    "# CTRL-vs-disease RAAS scatter restricted to the SAAPs the 4a heatmap flags as significant\n",
    "# (sig_stats — the shared per-SAAP rule). One panel per disease; each point is one significant\n",
    "# SAAP's per-replicate-aggregated log10 RAAS, colored by its substitution (swap) type.\n",
    "# Swap-type colors match the 4b volcano.\n",
    "def plot_significant_saap_scatter(cohort, agg=scatter_agg, min_pts=min_reps):\n",
    "    cohort_df, name, neuro = cohort['df'], cohort['name'], cohort['neuro']\n",
    "    sig_all = cohort['sig_stats']\n",
    "    swap_colors = swap_palette(cohort['df']['aa_sub'].unique())        # complete & consistent palette\n",
    "    if sig_all is None or sig_all.empty:\n",
    "        print(f'[{name}] no significant SAAPs to scatter.'); return\n",
    "    per = (cohort_df.groupby(SAAP_KEYS + ['Disease'], observed=True)['log10_RAAS']\n",
    "           .agg(['mean', 'median', 'size']).reset_index())\n",
    "    val = per.pivot_table(index=SAAP_KEYS, columns='Disease', values=agg)\n",
    "    cnt = per.pivot_table(index=SAAP_KEYS, columns='Disease', values='size')\n",
    "    cmps = [d for d in neuro if d in sig_all['comparison'].unique()]\n",
    "    fig, axes = plt.subplots(1, len(cmps), figsize=(len(cmps) * 3.6, 3.8), sharex=True, sharey=True)\n",
    "    axes = np.atleast_1d(axes)\n",
    "    pooled = []\n",
    "    for ax, d in zip(axes, cmps):\n",
    "        xs, ys, cs = [], [], []\n",
    "        for key in (tuple(k) for k in sig_all.loc[sig_all['comparison'] == d, SAAP_KEYS].values):\n",
    "            if key not in val.index or ctrl_label not in val.columns or d not in val.columns:\n",
    "                continue\n",
    "            if (cnt.loc[key, ctrl_label] < min_pts) or (cnt.loc[key, d] < min_pts):\n",
    "                continue\n",
    "            x, y = val.loc[key, ctrl_label], val.loc[key, d]\n",
    "            if np.isnan(x) or np.isnan(y):\n",
    "                continue\n",
    "            xs.append(x); ys.append(y); cs.append(swap_colors.get(key[2], COLOR_NS))\n",
    "        ax.scatter(xs, ys, s=POINT_SIZE, alpha=ALPHA, c=cs, edgecolor=EDGE_COLOR)\n",
    "        pooled += xs + ys\n",
    "        ax.set_title(f'{d} vs CTRL  (n={len(xs)})', fontsize=TITLE_SIZE)\n",
    "        ax.set_xlabel(r'log$_{10}$[RAAS$_{CTRL}$]', fontsize=LABEL_SIZE)\n",
    "        ax.spines['left'].set_visible(True); ax.spines['bottom'].set_visible(True)\n",
    "        ax.tick_params(left=True, bottom=True, length=3, labelsize=TICK_SIZE)\n",
    "    if pooled:\n",
    "        lo, hi = float(np.nanmin(pooled)), float(np.nanmax(pooled))\n",
    "        for ax in axes:\n",
    "            ax.plot([lo, hi], [lo, hi], color='red', ls='--', lw=LINE_W)\n",
    "    axes[0].set_ylabel(r'log$_{10}$[RAAS$_{disease}$]', fontsize=LABEL_SIZE)\n",
    "    present = sorted(sig_all['aa_sub'].unique())                                       # shared swap legend\n",
    "    handles = [Line2D([0], [0], marker='o', ls='', markersize=6, markeredgecolor='none',\n",
    "                      markerfacecolor=swap_colors[a], label=a.replace(' to ', '→')) for a in present]\n",
    "    fig.legend(handles=handles, title='substitution', fontsize=LEGEND_SIZE, title_fontsize=LEGEND_SIZE,\n",
    "               frameon=False, loc='center left', bbox_to_anchor=(1.0, 0.5),\n",
    "               ncol=1 if len(handles) <= 18 else 2)\n",
    "    fig.suptitle(f'{name}: significant SAAPs — CTRL vs disease RAAS (per SAAP)\\n'\n",
    "                 f'(Welch t vs CTRL, {sig_metric_label} ≤ {sel_thresh} & |log$_2$FC| ≥ {min_abs_log2fc}; ≥{min_reps} reps/group; dashed = identity)',\n",
    "                 fontsize=TITLE_SIZE)\n",
    "    plt.tight_layout()\n",
    "    fig.savefig(f'{PLOT_DIR}SAAP_significant_scatter_{name}.pdf', bbox_inches='tight')\n",
    "    plt.show()\n"
   ]
  },
