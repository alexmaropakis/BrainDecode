   ],
   "source": [
    "# ── Plot: reference proteins ranked by median RAAS — highest-RAAS proteins highlighted ──\n",
    "# DESCRIPTIVE (no significance claim). A robust per-protein significance test isn't supportable here:\n",
    "# 187/254 proteins have a single SAAP, and pooling all per-observation RAAS is pseudo-replication\n",
    "# (that gives 105/245 'significant' at FDR<0.01, but the proper per-SAAP-median test gives ~0, and\n",
    "# only 2 even at nominal p<0.05). Disease significance lives at the SAAP level (section 4 / the\n",
    "# disease-significant plot). So here we simply mark the top-N proteins by median RAAS.\n",
    "TOP_N = 15\n",
    "sns.set_style('ticks')\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.scatter(ref_prot_df['Rank'], ref_prot_df['Median RAAS'], color='#cccccc', s=45, linewidth=0, zorder=1)\n",
    "hot = ref_prot_df.nlargest(TOP_N, 'Median RAAS')\n",
    "ax.scatter(hot['Rank'], hot['Median RAAS'], color=POOLED_COLOR, s=58, linewidth=0, zorder=3,\n",
    "           label=f'highest-RAAS proteins (top {TOP_N})')\n",
    "ax.set_xlabel('Protein rank', fontsize=16); ax.set_ylabel(r'Median log$_{10}$(RAAS)', fontsize=16)\n",
    "ax.tick_params('both', labelsize=13); ax.legend(fontsize=10, bbox_to_anchor=(1.01, 1), loc='upper left')\n",
    "hl = hot.copy(); hl['label'] = hl['Genes'].map(lambda g: g[0] if g else ''); hl['color'] = POOLED_COLOR\n",
    "hl = hl.sort_values('Median RAAS', ascending=False).drop_duplicates('label')\n",
    "label_ranked(ax, hl)\n",
    "despine()\n",
    "plt.savefig(PLOT_DIR + 'Protein_RAAS_rank_topRAAS.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
  {
   "cell_type": "code",
