   ],
   "source": [
    "# ── Build Reference_proteins_ranked_Median_RAAS.xlsx ──────────────────────────\n",
    "# One row per source protein: median RAAS across its SAAPs (per-SAAP median Reporter_RAAS), ranked\n",
    "# high -> low. Source protein / gene come from the BLASTp keep set; description from HUMAN.fasta.\n",
    "prot_map  = blast_filtered[['MTP_seq', 'gene', 'accession']].drop_duplicates('MTP_seq')\n",
    "saap_raas = (SAAP_quant_df.replace([np.inf, -np.inf], np.nan)\n",
    "             .groupby('MTP_seq', as_index=False)['Reporter_RAAS'].median()\n",
    "             .rename(columns={'Reporter_RAAS': 'saap_raas'}))\n",
    "m = prot_map.merge(saap_raas, on='MTP_seq', how='inner').dropna(subset=['saap_raas'])\n",
    "\n",
    "ref_prot_df = (m.groupby('accession')\n",
    "               .agg(SAAPs=('MTP_seq', lambda s: sorted(set(s))),\n",
    "                    **{'Median RAAS': ('saap_raas', 'median')},\n",
    "                    **{'N SAAP': ('MTP_seq', 'nunique')},\n",
    "                    Genes=('gene', lambda s: sorted({x for x in s if pd.notna(x)})))\n",
    "               .reset_index())\n",
    "ref_prot_df['Reference protein'] = ref_prot_df['accession'].map(lambda a: PROT_DESC.get(acc_to_seq(a)[0], a))\n",
    "ref_prot_df = ref_prot_df.sort_values('Median RAAS', ascending=False).reset_index(drop=True)\n",
    "ref_prot_df['Rank'] = range(len(ref_prot_df))\n",
    "\n",
    "# enrichment-derived columns (filled separately from GSEA + manual curation) — blank placeholders\n",
    "ref_prot_df['GO terms'] = ''\n",
    "ref_prot_df['Pathway group'] = ''\n",
    "ref_prot_df['is TF'] = False\n",
    "\n",
    "ref_prot_df = ref_prot_df[['Reference protein', 'SAAPs', 'Median RAAS', 'N SAAP', 'Rank',\n",
    "                           'Genes', 'GO terms', 'Pathway group', 'is TF', 'accession']]\n",
    "ref_prot_df.to_excel(OUTDIR + 'Reference_proteins_ranked_Median_RAAS.xlsx')\n",
    "print(f'{len(ref_prot_df)} reference proteins ranked -> {OUTDIR}Reference_proteins_ranked_Median_RAAS.xlsx')\n",
    "print(f'  (funnel: {SAAP_quant_df[\"MTP_seq\"].nunique()} unique SAAPs -> '\n",
    "      f'{prot_map[\"MTP_seq\"].nunique()} with a BLASTp source protein -> '\n",
    "      f'{len(m)} SAAP-protein rows with RAAS -> {len(ref_prot_df)} unique proteins)')\n",
    "print(ref_prot_df.head(8)[['Reference protein', 'Median RAAS', 'N SAAP', 'Genes']].to_string())\n",
    "\n",
    "def label_ranked(ax, pts, fontsize=7.5):\n",
    "    \"\"\"Place point labels in two evenly-spaced rows (top/bottom margins) with leader lines, so they\n",
    "    don't overlap. pts: DataFrame with columns Rank, 'Median RAAS', label, color (dedupe beforehand).\"\"\"\n",
    "    pts = pts[pts['label'].astype(bool)].sort_values('Rank').reset_index(drop=True)\n",
    "    if pts.empty:\n",
    "        return\n",
    "    x0, x1 = ax.get_xlim(); ymin, ymax = ax.get_ylim(); pad = (ymax - ymin) * 0.24\n",
    "    ax.set_ylim(ymin - pad, ymax + pad); span = x1 - x0\n",
    "    ytop, ybot = ax.get_ylim()[1] - pad * 0.45, ax.get_ylim()[0] + pad * 0.45\n",
    "    for grp, ylab, va in [(pts.iloc[::2], ytop, 'top'), (pts.iloc[1::2], ybot, 'bottom')]:\n",
    "        if not len(grp):\n",
    "            continue\n",
    "        xs = np.linspace(x0 + span * 0.03, x1 - span * 0.03, len(grp))\n",
    "        for xlab, (_, r) in zip(xs, grp.iterrows()):\n",
    "            ax.annotate(r['label'], xy=(r['Rank'], r['Median RAAS']), xytext=(xlab, ylab),\n",
    "                        textcoords='data', ha='center', va=va, fontsize=fontsize, color=r['color'],\n",
    "                        arrowprops=dict(arrowstyle='-', color='gray', lw=0.4))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 214,
   "id": "refprot_enrich",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0 TFs flagged; pathway groups:\n",
      "Pathway group\n",
      "(unclassified)                        66\n",
      "Small molecule metabolism             66\n",
      "Signaling and enzymatic reactions     32\n",
      "Cytoskeletal and structural           30\n",
      "Immune response                       21\n",
      "DNA, RNA processing and metabolism    19\n",
      "Protein transport and degradation     17\n",
      "Oxidative stress response              3\n"
     ]
    }
   ],
   "source": [
    "# ── Annotate reference proteins: GO terms / Pathway group / is TF ─────────────\n",
    "# No local GO/TF resources, so fetch public ones (cached to DEPDIR after the first run, then offline):\n",
    "#   • human TF list (Lambert et al. 2018)            -> is TF\n",
    "#   • GO Biological Process sets (Enrichr 2021)       -> GO terms (per gene)\n",
    "# 'Pathway group' is an APPROXIMATE keyword roll-up of each protein's GO terms into the figure's\n",
    "# categories (the original grouping was hand-curated) — review / edit it in the xlsx as needed.\n",
    "import requests, re, collections\n",
    "\n",
    "def _cached_download(url, path):\n",
    "    if not os.path.exists(path):\n",
    "        open(path, 'w').write(requests.get(url, timeout=60).text)\n",
    "    return open(path).read()\n",
    "\n",
    "TF_SET = {x.strip().upper() for x in _cached_download(\n",
    "    'http://humantfs.ccbr.utoronto.ca/download/v_1.01/TF_names_v_1.01.txt',\n",
    "    DEPDIR + 'human_TF_list_Lambert2018.txt').splitlines() if x.strip()}\n",
    "\n",
    "GENE2GO = collections.defaultdict(list)\n",
    "for ln in _cached_download(\n",
    "        'https://maayanlab.cloud/Enrichr/geneSetLibrary?mode=text&libraryName=GO_Biological_Process_2021',\n",
    "        DEPDIR + 'GO_Biological_Process_2021.gmt').strip().split('\\n'):\n",
    "    parts = ln.split('\\t')\n",
    "    for gn in parts[2:]:\n",
    "        if gn:\n",
    "            GENE2GO[gn.split(',')[0].upper()].append(parts[0])\n",
    "\n",
    "# keyword roll-up of GO terms -> the figure's pathway buckets (first bucket with the most hits wins)\n",
    "PATHWAY_KEYWORDS = [\n",
    "    ('Oxidative stress response', ['oxidative stress', 'reactive oxygen', 'antioxidant', 'detoxif', 'redox']),\n",
    "    ('Immune response', ['immun', 'inflamm', 'leukocyte', 'cytokine', 'interferon', 'antigen', 'defense response', 'complement']),\n",
    "    ('Protein transport and degradation', ['proteasom', 'ubiquitin', 'autophag', 'lysosom', 'vesicle', 'endosom', 'protein transport', 'protein catabolic', 'golgi', 'secretion']),\n",
    "    ('DNA, RNA processing and metabolism', ['dna', 'rna', 'transcription', 'splic', 'translation', 'ribosom', 'chromatin', 'mrna', 'helicase', 'nucleotide']),\n",
    "    ('Cytoskeletal and structural', ['cytoskelet', 'actin', 'microtubule', 'tubulin', 'myosin', 'filament', 'cell adhesion', 'structural']),\n",
    "    ('Small molecule metabolism', ['lipid', 'fatty acid', 'glucose', 'amino acid', 'small molecule', 'biosynthetic', 'catabolic', 'metabolic process']),\n",
    "    ('Signaling and enzymatic reactions', ['signaling', 'kinase', 'phosphoryl', 'gtpase', 'receptor', 'catalytic']),\n",
    "]\n",
    "\n",
    "def _gene_tokens(genes):\n",
    "    return [t.strip().upper() for g in genes for t in re.split(r'[;/,]', str(g)) if t.strip()]\n",
    "\n",
    "def _go_for(genes, cap=15):\n",
    "    terms = [t for tok in _gene_tokens(genes) for t in GENE2GO.get(tok, [])]\n",
    "    return list(dict.fromkeys(terms))[:cap]\n",
    "\n",
    "def _pathway_group(go_terms, is_tf):\n",
    "    if is_tf:\n",
    "        return 'Transcription factor'\n",
    "    txt = ' ; '.join(go_terms).lower()\n",
    "    best, score = '', 0\n",
    "    for bucket, kws in PATHWAY_KEYWORDS:\n",
    "        s = sum(txt.count(k) for k in kws)\n",
    "        if s > score:\n",
    "            best, score = bucket, s\n",
    "    return best\n",
    "\n",
    "ref_prot_df['is TF'] = ref_prot_df['Genes'].map(lambda gs: any(t in TF_SET for t in _gene_tokens(gs)))\n",
    "ref_prot_df['GO terms'] = ref_prot_df['Genes'].map(_go_for)\n",
    "ref_prot_df['Pathway group'] = [_pathway_group(go, tf) for go, tf in zip(ref_prot_df['GO terms'], ref_prot_df['is TF'])]\n",
    "ref_prot_df.to_excel(OUTDIR + 'Reference_proteins_ranked_Median_RAAS.xlsx')\n",
    "\n",
    "print(f\"{ref_prot_df['is TF'].sum()} TFs flagged; pathway groups:\")\n",
    "print(ref_prot_df['Pathway group'].replace('', '(unclassified)').value_counts().to_string())"
   ]
