   "metadata": {},
   "outputs": [],
   "source": [
    "## Formatting — constants & figure aesthetics\n",
    "# Single source of truth for every analysis/plot knob. Change things HERE.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# ── Columns / grouping ───────────────────────────────────────────────────────\n",
    "raas_col      = 'Reporter_RAAS'                      # RAAS column used for most analyses\n",
    "ctrl_label    = 'CTRL'\n",
    "disease_order = ['CTRL', 'AD', 'PD', 'ADPD']         # canonical disease plotting order\n",
    "disease_map   = {'CTRL': 1, 'AD': 2, 'PD': 3, 'ADPD': 4}   # ordinal coding for trend tests\n",
    "SAAP_KEYS     = ['MTP_seq', 'BP_seq', 'aa_sub']      # unique SAAP identity\n",
    "TISSUE_ORDER  = ['acg', 'fc']                        # canonical tissue order: ACG before FC\n",
    "\n",
    "# canonical AA ordering for standardized plotting\n",
    "aa_order = ['G', 'A', 'V', 'L', 'I', 'M', 'P', 'F', 'Y', 'W',\n",
    "            'S', 'T', 'C', 'N', 'Q', 'D', 'E', 'K', 'R', 'H']\n",
    "\n",
    "# AA biochemical groups (conservative vs nonconservative classification)\n",
    "aa_groups = {\n",
    "    'A': 'nonpolar', 'V': 'nonpolar', 'L': 'nonpolar', 'I': 'nonpolar', 'M': 'nonpolar',\n",
    "    'F': 'aromatic', 'W': 'aromatic', 'Y': 'aromatic',\n",
    "    'S': 'polar', 'T': 'polar', 'N': 'polar', 'Q': 'polar', 'C': 'polar',\n",
    "    'K': 'positive', 'R': 'positive', 'H': 'positive',\n",
    "    'D': 'negative', 'E': 'negative',\n",
    "    'G': 'special', 'P': 'special',\n",
    "}\n",
    "\n",
    "# ── Analysis toggles & thresholds (statistics — change deliberately) ──────────\n",
    "COMPLETE_SAAPS_ONLY = True   # keep only SAAPs seen in EVERY disease state (applied per cohort)\n",
    "min_saap          = 2        # min SAAPs per aa_sub for Friedman / Wilcoxon / Spearman subtype tests\n",
    "min_saap_per_aas  = 2        # min qualifying SAAPs per AAS for tissue fold-change heatmaps\n",
    "min_reps          = 1        # min replicates per group for disease-vs-CTRL t-tests\n",
    "min_obs           = 3        # min observations per group for the tissue ANOVA + Tukey\n",
    "min_abs_log2fc    = 0.5      # |log2FC| threshold for significant heatmaps\n",
    "fdr_thresh        = 0.01     # BH-FDR threshold (subtype analysis)\n",
    "q_thresh          = 0.01     # significance cutoff for the aa_sub volcano\n",
    "# Section-4 SAAP-level significance metric — single toggle for ALL of 4a-4g.\n",
    "USE_FDR           = False    # False -> nominal p<=0.05 ; True -> BH-FDR<=0.01\n",
    "sel_metric        = 'FDR' if USE_FDR else 'p_value'   # selection metric (heatmap + 4b-4g)\n",
    "sel_thresh        = 0.01 if USE_FDR else 0.05         # matched threshold for that metric\n",
    "sig_metric_label  = 'FDR' if USE_FDR else 'p'         # for axis labels / annotations\n",
    "scatter_agg       = 'mean'   # per-SAAP collapse for the substitution scatter\n",
    "\n",
    "# pairwise comparison column labels for the tissue ANOVA/Tukey table\n",
    "pairwise_cols = lambda tissues: [f'{a}_vs_{b}' for a, b in combinations(sorted(tissues), 2)]\n",
    "\n",
    "# ── Colors & colormap ─────────────────────────────────────────────────────────\n",
    "# RAAS / log2FC heatmap spectrum (low -> mid -> high); every colorbar matches this vibe.\n",
    "cmap = LinearSegmentedColormap.from_list('pinky_RAAS', ['#027FC1', '#F8D7A7', '#FD7E81'], N=256)\n",
    "\n",
    "# Tissue colors — ACG is ALWAYS this blue, FC ALWAYS this orange, everywhere.\n",
    "ACG_color = \"#3AE885\"   # anterior cingulate gyrus (blue)\n",
    "FC_color  = \"#E86E3A\"   # frontal cortex (orange)\n",
    "TISSUE_COLORS = {'acg': ACG_color, 'fc': FC_color}\n",
    "\n",
    "# Pooled / combined-tissue series (e.g. fragment-ion support, pooled Brain) — ALWAYS purple,\n",
    "# kept in the same vibe as the heatmap spectrum.\n",
    "POOLED_COLOR = \"#A27DD9\"\n",
    "\n",
    "# Disease colors — AD / PD / ADPD each ALWAYS the same color in every scatter/plot.\n",
    "DISEASE_COLORS = {'CTRL': '#9E9E9E', 'AD': \"#9E9E9E\", 'PD': \"#9E9E9E\", 'ADPD': \"#9E9E9E\"}\n",
    "\n",
    "# Neutral / QC-distribution accents\n",
    "GRAY      = '#aaaaaa'   # default neutral fill\n",
    "QC_REF    = '#9E9E9E'   # secondary series (e.g. BP / excluded)\n",
    "QC_COLOR  = \"#027FC1\"   # SAAP QC distributions\n",
    "LOC_COLOR = \"#027FC1\"   # positional probability\n",
    "PEP_COLOR = \"#027FC1\"   # SAAP PEP\n",
    "AF_COLOR  = \"#E83A77\"   # allele frequency (AF) filter for the SAAP scatter \n",
    "\n",
    "# Volcano up / down / not-significant\n",
    "COLOR_UP, COLOR_DOWN, COLOR_NS = '#E83A77', '#027FC1', '#9E9E9E'\n",
    "COLOR_SIG, COLOR_NSIG = \"#E83A77\", \"#9E9E9E\"\n",
    "\n",
    "# ── Uniform marker / text sizing (used by every scatter & annotation) ─────────\n",
    "ALPHA       = 1   # marker transparency everywhere\n",
    "POINT_SIZE  = 22     # scatter marker size everywhere\n",
    "EDGE_COLOR  = 'none'\n",
    "LINE_W      = 1.5    # reference / identity lines\n",
    "ANNOT_SIZE  = 9      # in-axes stat annotations\n",
    "LEGEND_SIZE = 8\n",
    "TITLE_SIZE  = 15\n",
    "LABEL_SIZE  = 12\n",
    "TICK_SIZE   = 9\n",
    "\n",
    "\n",
    "def tissue_color(name):\n",
    "    \"\"\"ACG_color for acg* tissues/datasets; FC_color otherwise (fc*).\"\"\"\n",
    "    return ACG_color if str(name).lower().startswith('acg') else FC_color\n",
    "\n",
    "\n",
    "def pretty_disease(label):\n",
    "    \"\"\"Show only the disease descriptor, dropping any tissue/batch prefix\n",
    "    ('acg_CTRL' -> 'CTRL', 'acgb1_AD' -> 'AD', 'CTRL' -> 'CTRL').\"\"\"\n",
    "    s = str(label)\n",
    "    if '_' in s and s.rsplit('_', 1)[1].upper() in [d.upper() for d in disease_order]:\n",
    "        return s.rsplit('_', 1)[1]\n",
    "    return s\n",
    "\n",
    "\n",
    "def fmt_sci(x, sig=2):\n",
    "    \"\"\"Statistical values (p, q, r, rho, F, ...) as compact scientific mathtext.\"\"\"\n",
    "    if x is None or (isinstance(x, float) and np.isnan(x)):\n",
    "        return 'n/a'\n",
    "    if x == 0:\n",
    "        return '0'\n",
    "    m, e = f'{x:.{sig}e}'.split('e')\n",
    "    return rf'{m}$\\times$10$^{{{int(e)}}}$'\n",
    "\n",
    "\n",
    "def fmt_cbar(x):\n",
    "    \"\"\"Clean colorbar tick label: plain for moderate magnitudes, scientific at the extremes.\"\"\"\n",
    "    if x == 0:\n",
    "        return '0'\n",
    "    if 1e-2 <= abs(x) < 1e3:\n",
    "        return f'{x:.2g}'\n",
    "    m, e = f'{x:.1e}'.split('e')\n",
    "    return rf'{m}$\\times$10$^{{{int(e)}}}$'\n",
    "\n",
    "\n",
    "def order_tissue_disease(cols):\n",
    "    \"\"\"Order 'tissue_disease' columns as ACG (all diseases) then FC (all diseases).\"\"\"\n",
    "    rank = {f'{t}_{d}': (ti, di) for ti, t in enumerate(TISSUE_ORDER)\n",
    "            for di, d in enumerate(disease_order)}\n",
    "    return sorted(cols, key=lambda c: rank.get(c, (99, 99)))"
   ]
  },
  {
   "cell_type": "code",
