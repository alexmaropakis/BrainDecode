   "source": [
    "# Global RAAS distribution by disease state (one panel per disease), per tissue.\n",
    "# Each SAAP contributes the median RAAS of its replicates within a (dataset, disease).\n",
    "for grouped_df, tcolor, tname in [(SAAP_quant_df_grouped_acg, ACG_color, 'acg'),\n",
    "                                  (SAAP_quant_df_grouped_fc, FC_color, 'fc')]:\n",
    "    disease_df = saap_level_median(grouped_df.copy(), group_cols=['Dataset', 'Sample Type'], value_col='Reporter_RAAS')\n",
    "    disease_df = disease_df.dropna(subset=['Reporter_RAAS'])\n",
    "    diseases = [d for d in disease_order if d in disease_df['Sample Type'].unique()]\n",
    "    fig, axes = plt.subplots(1, len(diseases), figsize=(5 * len(diseases), 6.5), sharey=True, constrained_layout=True)\n",
    "    for ax, d in zip(np.atleast_1d(axes), diseases):\n",
    "        vals = disease_df.loc[disease_df['Sample Type'] == d, 'Reporter_RAAS'].dropna().values\n",
    "        sns.histplot(vals, bins=40, ax=ax, color=tcolor, edgecolor=None, linewidth=0)\n",
    "        med = np.nanmedian(vals)\n",
    "        ax.axvline(med, color='red', linestyle='--', linewidth=3)\n",
    "        ax.set_title(f'{d}\\n(n = {len(vals)})', fontsize=20)\n",
    "        ax.tick_params(axis='both', labelsize=20, length=5, width=2)\n",
    "        ax.set_xlabel('RAAS', fontsize=20); ax.set_ylabel('Count', fontsize=20)\n",
    "        ax.set_xticks([-4, -2, 0, 2, 4]); ax.grid(False); despine()\n",
    "        ax.text(0.05, 0.95, f'median = {med:.2f}', transform=ax.transAxes, fontsize=17, va='center_baseline')\n",
    "    plt.suptitle(f'{tname.upper()}: global RAAS distribution by disease', fontsize=25)\n",
    "    plt.savefig(f'{PLOT_DIR}Global_RAAS_by_disease_{tname}.pdf'); plt.show()\n"
   ]
  },
