   ],
   "source": [
    "# Plot the BLASTp source-protein assignment outcome for every detected SAAP.\n",
    "# (Annotation onto the quant table is done comprehensively further down — see the export cell.)\n",
    "# Broken y-axis: 'keep' (mapped to a source protein, ~800) dwarfs the drop categories (<=82).\n",
    "status_order = ['keep', 'drop_no_parent', 'drop_reference', 'drop_trypsin', 'drop_ig']\n",
    "sc = (blast_unfiltered['status'].value_counts()\n",
    "      .reindex([s for s in status_order if s in blast_unfiltered['status'].values]))\n",
    "n_keep, n_tot = int((blast_unfiltered['status'] == 'keep').sum()), len(blast_unfiltered)\n",
    "status_labels = {'keep': 'source protein\\nfound', 'drop_no_parent': 'no source\\nprotein',\n",
    "                 'drop_reference': 'exact ref.\\nmatch', 'drop_trypsin': 'trypsin\\n(reagent)',\n",
    "                 'drop_ig': 'immuno-\\nglobulin'}\n",
    "labels = [status_labels.get(s, s) for s in sc.index]\n",
    "colors = [ACG_color if s == 'keep' else COLOR_UP for s in sc.index]\n",
    "xpos = np.arange(len(sc)); hi = sc.values > 95          # 'keep' lives in the upper segment\n",
    "\n",
    "fig, (ax_top, ax_bot) = plt.subplots(2, 1, sharex=True, figsize=(5, 4.5),\n",
    "                                     gridspec_kw={'height_ratios': [1, 3], 'hspace': 0.05})\n",
    "# draw the FULL set of bars in BOTH panels; each panel's ylim shows a different slice, so the\n",
    "# 'keep' bar reads as one whole bar broken only by the axis cut\n",
    "ax_top.bar(xpos, sc.values, color=colors)\n",
    "ax_bot.bar(xpos, sc.values, color=colors)\n",
    "ax_top.set_ylim(770, 820); ax_top.set_yticks([800]); ax_bot.set_ylim(0, 95)\n",
    "for i, v in enumerate(sc.values):\n",
    "    (ax_top if hi[i] else ax_bot).annotate(f'{v}', (xpos[i], v), ha='center', va='bottom', fontsize=10)\n",
    "\n",
    "despine(ax_top); despine(ax_bot)\n",
    "ax_top.spines['bottom'].set_visible(False); ax_top.tick_params(bottom=False, labelbottom=False)\n",
    "ax_bot.spines['top'].set_visible(False)\n",
    "brk = dict(marker=[(-1, -0.5), (1, 0.5)], markersize=8, linestyle='none', color='k', mec='k', mew=1, clip_on=False)\n",
    "ax_top.plot([0], [0], transform=ax_top.transAxes, **brk)   # break mark on the y-axis only (no floating right-side marks)\n",
    "ax_bot.plot([0], [1], transform=ax_bot.transAxes, **brk)\n",
    "\n",
    "ax_bot.set_xticks(xpos); ax_bot.set_xticklabels(labels, fontsize=8)\n",
    "ax_top.tick_params(axis='y', labelsize=11); ax_bot.tick_params(axis='y', labelsize=11)\n",
    "fig.supylabel('# detected SAAPs', fontsize=13)\n",
    "ax_top.set_title(f'BLASTp source-protein assignment\\n({n_keep}/{n_tot} mapped, {100 * n_keep / n_tot:.0f}%)', fontsize=12)\n",
    "plt.savefig(PLOT_DIR + 'QC_BLASTp_filtering_outcome.pdf', bbox_inches='tight'); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "13801f58",
