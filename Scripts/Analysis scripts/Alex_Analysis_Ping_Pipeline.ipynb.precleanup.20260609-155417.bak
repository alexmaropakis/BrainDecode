    "print(ds_metrics)\n",
    "\n",
    "plt.figure(figsize=(6,4))\n",
    "ax = sns.barplot(\n",
    "    data=ds_metrics,\n",
    "    x='Dataset',\n",
    "    y='Unique peptides',\n",
    "    hue='Dataset',\n",
    "    palette={d: tissue_color(d) for d in datasets},\n",
    "    legend=False,\n",
    "    linewidth=0.5,\n",
    "    alpha=1\n",
    ")\n",
    "\n",
    "ax.set_yscale('log')\n",
    "ax.set_ylim([10, 1e5])\n",
    "ax.set_ylabel('# unique peptides', fontsize=13)\n",
    "ax.set_xlabel('TMT set', fontsize=13)\n",
    "ax.tick_params(axis='x', rotation=40, labelsize=11)\n",
    "ax.tick_params(axis='y', labelsize=11)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.tick_params(axis='both', length=5)\n",
    "despine()\n",
    "plt.title('Unique peptides per TMT set\\n(unique peptide sequences; log scale)',fontsize=12)\n",
    "plt.savefig(PLOT_DIR + 'Unique_peptides_per_dataset.pdf', bbox_inches='tight')\n",
    "plt.show()"
   ]
