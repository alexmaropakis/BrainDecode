    "print(plot_df)\n",
    "\n",
    "plt.figure(figsize=(3,3))\n",
    "sns.set_style(style='ticks')\n",
    "ax = sns.barplot(data=plot_df, x='Category', y='Count',palette='colorblind',alpha=1)\n",
    "ax.set_yscale('log')\n",
