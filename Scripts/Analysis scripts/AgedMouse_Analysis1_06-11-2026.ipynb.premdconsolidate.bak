   ],
   "source": [
    "# drop the contaminant SAAPs and rebuild the per-dataset views\n",
    "n_before = len(SAAP_quant_df)\n",
    "SAAP_quant_df = SAAP_quant_df.loc[(SAAP_quant_df['immunoglobulin'] == 'NO') &\n",
