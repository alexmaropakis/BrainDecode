   "cell_type": "markdown",
   "id": "619f268c",
   "metadata": {},
   "source": [
    "# 3. RAAS Changes Associated with Aging"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "14bec322",
   "metadata": {},
   "source": [
    "## 3a Data pre-processing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 273,
   "id": "b1617ecd",
   "metadata": {},
   "outputs": [],
   "source": [
    "COMPLETE_SAAPS_ONLY = True # toggle True if wanting SAAPs detected in EVERY age group\n",
    "SAAP_KEYS     = ['MTP_seq', 'BP_seq', 'aa_sub']   \n",
    "age_order = ['t06mo', 't15mo', 't24mo', 't30mo']\n",
    "tissue_order = ['Aorta','Brain','Heart','Kidney','Liver','Lung','Muscle','Skin']\n",
    "\n",
    "# Functions to prepare data for analysis\n",
    "def data_prep(df):\n",
    "    saap_df = df.copy()\n",
    "    saap_df['Replicate'] = saap_df['Sample'].str.extract(r'_rep(\\d+)_',expand=False)\n",
    "    saap_df['Replicate'] = pd.to_numeric(saap_df['Replicate'], errors='coerce')\n",
    "    saap_df.replace([np.inf, -np.inf], np.nan).dropna(subset=['Reporter_RAAS'])\n",
    "    return saap_df\n",
    "\n",
    "def filter_complete_saaps(df, *, age_col='Age', saap_keys=SAAP_KEYS,\n",
    "                          within=None, complete_only=None):\n",
    "    complete_only = COMPLETE_SAAPS_ONLY if complete_only is None else complete_only\n",
    "    if not complete_only or age_col not in df.columns:\n",
    "        return df\n",
    "    grp = (within or []) + list(saap_keys)\n",
    "    states = [a for a in age_order if a in df[age_col].unique()]\n",
    "    present = (df[grp + [age_col]].drop_duplicates()\n",
    "               .groupby(grp, observed=True)[age_col].nunique())\n",
    "    keep = present[present == len(states)].reset_index()[grp]\n",
    "    return df.merge(keep, on=grp, how='inner')"
   ]
  },
