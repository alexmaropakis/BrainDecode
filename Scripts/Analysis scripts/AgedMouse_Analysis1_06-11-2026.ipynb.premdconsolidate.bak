, 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'QTALVELVK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'ALEESNYEAEGK', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR', 'LGEYGLQNALIVR']\n"
